@if (Cards.Count > 0)
{
    <h2>Shared with you</h2>
    <ul class="memories">
        @foreach (var c in Cards)
        {
            <li>
                <details class="memory memory--shared">
                    <summary>
                        <span class="memory__thumb" aria-hidden="true"><MemoryThumb Card="c" Decorative="true" /></span>
                        <span class="memory__words">
                            <span class="memory__title">@c.Title</span>
                            <span class="memory__date">@c.Date.ToString("d MMMM yyyy")</span>
                            <span>@c.Summary</span>
                        </span>
                    </summary>
                    <ol>
                        @foreach (var s in c.Steps)
                        {
                            <li>@s</li>
                        }
                    </ol>
                </details>
            </li>
        }
    </ul>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<MemoryCard> Cards { get; set; } = [];
}
