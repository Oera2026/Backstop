@inherits ModeComponentBase

<h2>Recent activity</h2>
@if (_entries is null && _problem is null)
{
    <LoadingState Text="Getting recent activity…" />
}
else if (_problem is not null)
{
    <ErrorState Message="@_problem" OnRetry="Load" />
}
else if (_entries!.Count == 0)
{
    <p class="empty">Nothing has happened yet.</p>
}
else
{
    <ul class="activity">
        @foreach (var a in _entries)
        {
            <li>
                <Icon Name="@a.Icon" />
                <span>@a.Text <time datetime="@a.At.ToString("o")">@Clock.When(a.At)</time></span>
            </li>
        }
    </ul>
}

@code {
    private IReadOnlyList<ActivityEntry>? _entries;
    private string? _problem;

    protected override Task OnInitializedAsync() => Load();
    protected override Task OnApiChangedAsync() => Load();

    private async Task Load()
    {
        _problem = null;
        try { _entries = await Api.GetActivityAsync(); }
        catch (BackstopApiException ex) { _problem = ex.Message; }
    }
}
