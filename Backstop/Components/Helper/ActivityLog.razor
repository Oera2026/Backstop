@* The parent loads the entries once for the whole page. Nothing here fetches. *@
@if (Heading.Length > 0)
{
    <h2>@Heading</h2>
}
@if (Entries.Count == 0)
{
    <p class="empty">Nothing has happened yet.</p>
}
else
{
    <ul class="activity">
        @foreach (var a in Entries)
        {
            <li>
                <Icon Name="@a.Icon" />
                <span>@a.Text <time datetime="@a.At.ToString("o")">@Clock.When(a.At)</time></span>
            </li>
        }
    </ul>
}

@code {
    [Parameter] public string Heading { get; set; } = "Recent activity";
    [Parameter, EditorRequired] public IReadOnlyList<ActivityEntry> Entries { get; set; } = [];
    [CascadingParameter] private UserClock Clock { get; set; } = UserClock.Server;
}
