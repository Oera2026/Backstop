@* Stories the user asked for about a sensitive topic. They wait here until the helper decides. *@
@if (Items.Count > 0)
{
    <h2>Stories to read first</h2>
    <ul class="rows" aria-label="Held stories">
        @foreach (var i in Items)
        {
            <li>
                <a class="row" href="helper/story/@i.Id">
                    <span class="pic pic--check" aria-hidden="true"><Icon Name="story" /></span>
                    <span class="row__main">
                        <span class="row__from">@i.Title</span>
                        <span class="row__subject">@i.Flags[0].Title</span>
                    </span>
                    <span class="row__side">
                        <StatusBadge State="MessageState.Held" ForHelper="true" />
                        <span class="row__time">@Clock.When(i.At)</span>
                    </span>
                </a>
            </li>
        }
    </ul>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ReviewItem> Items { get; set; } = [];
    [CascadingParameter] private UserClock Clock { get; set; } = UserClock.Server;
}
