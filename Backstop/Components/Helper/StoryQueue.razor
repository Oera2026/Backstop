@inherits ModeComponentBase

@* Stories the user asked for about a sensitive topic. They wait here until the helper decides. *@
@if (_items is { Count: > 0 })
{
    <h2>Stories to read first</h2>
    <ul class="rows" aria-label="Held stories">
        @foreach (var i in _items)
        {
            <li>
                <a class="row" href="helper/story/@i.Id">
                    <span class="pic pic--check" aria-hidden="true"><Icon Name="story" /></span>
                    <span class="row__main">
                        <span class="row__from">@i.Title</span>
                        <span class="row__subject">@i.Flags[0].Title</span>
                    </span>
                    <span class="row__side">
                        <StatusBadge State="MessageState.Held" ForHelper="true" />
                        <span class="row__time">@Clock.When(i.At)</span>
                    </span>
                </a>
            </li>
        }
    </ul>
}
else if (_problem is not null)
{
    <ErrorState Message="@_problem" OnRetry="Load" />
}

@code {
    private IReadOnlyList<ReviewItem>? _items;
    private string? _problem;

    protected override Task OnInitializedAsync() => Load();
    protected override Task OnApiChangedAsync() => Load();

    private async Task Load()
    {
        _problem = null;
        try { _items = (await Api.GetReviewQueueAsync()).Where(i => i.Source == ReviewSource.Story).ToList(); }
        catch (BackstopApiException ex) { _problem = ex.Message; }
    }
}
