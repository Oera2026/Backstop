@implements IDisposable

<article class="evidence" aria-labelledby="ev-title">
    <p class="evidence__status">
        <StatusBadge State="Message.State" ForHelper="true" />
    </p>
    <h1 id="ev-title">@Message.Subject</h1>
    <p class="evidence__who">From <strong>@Message.FromName</strong> <code>@Defang.ForHelper(Message.FromAddress)</code></p>

    @if (Message.State == MessageState.Held)
    {
        <div class="banner @(Message.Confidence == Confidence.High ? "banner--block" : "banner--check")">
            <Icon Name="alert" />
            <div>
                <p class="verdict__head">@VerdictHead</p>
                <p class="verdict__sub">@VerdictSub</p>
            </div>
        </div>
    }

    @if (Message.AwaitingScan && Message.State == MessageState.Held)
    {
        <div class="banner banner--check" role="status">
            <Icon Name="hourglass" />
            <p>The checker could not finish. This message stays held and is checked again soon.</p>
        </div>
    }

    <p class="lead">@Message.Summary</p>
    <div class="evidence__read"><ReadAloudButton Text="@($"{VerdictHead} {Message.Summary} {string.Join(' ', Message.Flags.Select(f => f.Title + ". " + f.Explanation))}")" /></div>

    @if (Message.Flags.Count > 0)
    {
        <section class="card" aria-labelledby="ev-flags">
            <h2 id="ev-flags">What looked wrong</h2>
            <ul class="flags">
                @foreach (var f in Message.Flags)
                {
                    <li class="flag">
                        <span class="flag__icon"><Icon Name="@f.Icon" /></span>
                        <span>
                            <strong>@f.Title</strong>
                            <span class="flag__text">@f.Explanation</span>
                        </span>
                    </li>
                }
            </ul>
        </section>
    }

    @if (Message.Links.Count > 0)
    {
        <details class="card fold">
            <summary>Link check (@Message.Links.Count)</summary>
            @foreach (var l in Message.Links)
            {
                <div class="linkcheck">
                    <p><Icon Name="link" /> <code>@l.DefangedUrl</code></p>
                    <p>@l.Verdict</p>
                    @if (l.Hops.Count > 1)
                    {
                        <p>Went through @l.Hops.Count websites:</p>
                        <ol class="hops">
                            @foreach (var h in l.Hops)
                            {
                                <li><code>@h</code></li>
                            }
                        </ol>
                    }
                    @if (l.TrackerWarning is not null)
                    {
                        <p class="warn"><Icon Name="eye" /> <span><strong>Tracker warning.</strong> @l.TrackerWarning</span></p>
                    }
                </div>
            }
        </details>
    }

    <details class="card fold" open>
        <summary>The message (text only, links made safe)</summary>
        <pre class="preview">@Defang.ForHelper(Message.Body)</pre>
    </details>

    @if (Message.State == MessageState.Held)
    {
        <div class="actionbar" role="group" aria-label="Your decision">
            @if (_pending is not null)
            {
                <p class="actionbar__msg" role="status">
                    <Icon Name="hourglass" />
                    <span>@(_pending == "Blocked" ? "Blocking" : "Approving") in @_secs seconds.</span>
                </p>
                <span class="countdown" style="--secs:@(UndoSeconds)s" aria-hidden="true"></span>
                <div class="actions">
                    <button type="button" class="btn btn-primary" @onclick="Undo"><Icon Name="arrow-left" /> Undo</button>
                </div>
            }
            else if (_confirming)
            {
                <p class="actionbar__msg" role="alert">
                    <Icon Name="alert" />
                    <span>@ConfirmText</span>
                </p>
                <div class="actions">
                    <button type="button" class="btn btn-primary" @onclick="CancelConfirm"><Icon Name="arrow-left" /> No, go back</button>
                    <button type="button" class="btn btn-quiet" @onclick="@(() => Start("Approved"))"><Icon Name="check" /> Yes, approve</button>
                </div>
            }
            else
            {
                @* Block only stands out when the checker is very sure. When it is not sure, both choices weigh the same. *@
                <div class="actions actions--helper">
                    <button type="button" class="btn @(Message.Confidence == Confidence.High ? "btn-block" : "btn-quiet btn-danger")" @onclick="@(() => Start("Blocked"))">
                        <Icon Name="cross" /> Block
                    </button>
                    @if (Message.AwaitingScan)
                    {
                        <button type="button" class="btn btn-quiet" disabled="@_scanning" @onclick="Rescan">
                            <Icon Name="refresh" /> @(_scanning ? "Checking…" : "Check again")
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-quiet" @onclick="AskConfirm">
                            <Icon Name="check" /> Approve
                        </button>
                    }
                    <button type="button" class="btn btn-text" @onclick="OnCallFirst">
                        <Icon Name="phone" /> Call them first
                    </button>
                </div>
            }
            <p class="call-note" role="status">
                @if (Message.CallRequested)
                {
                    <Icon Name="phone" /><span>You will call @Message.FromName before you decide.</span>
                }
            </p>
        </div>
    }
    else
    {
        <div class="banner @(Message.State == MessageState.Blocked ? "banner--block" : "banner--safe")" role="status">
            <Icon Name="@(Message.State == MessageState.Blocked ? "cross" : "check")" />
            <p>@DecisionText</p>
        </div>
        <p class="actions"><a class="btn btn-primary" href="/helper"><Icon Name="arrow-left" /> Back to the queue</a></p>
    }
</article>

@code {
    private const int UndoSeconds = 6;

    [Parameter, EditorRequired] public MailMessage Message { get; set; } = default!;
    [Parameter] public EventCallback OnApprove { get; set; }
    [Parameter] public EventCallback OnBlock { get; set; }
    [Parameter] public EventCallback OnCallFirst { get; set; }
    [Parameter] public EventCallback OnRescan { get; set; }

    private bool _scanning;

    private async Task Rescan()
    {
        _scanning = true;
        try { await OnRescan.InvokeAsync(); }
        finally { _scanning = false; }
    }

    private bool _confirming;
    private string? _pending;
    private int _secs;
    private CancellationTokenSource? _cts;

    private string VerdictHead => Message.Confidence switch
    {
        Confidence.High => "This looks like a scam.",
        Confidence.Medium => "This might be a scam.",
        _ => "We cannot tell if this is safe.",
    };

    private string VerdictSub => Message.Confidence switch
    {
        Confidence.High => "We are very sure. We suggest you block it.",
        Confidence.Medium => "We are fairly sure. Please read it with care.",
        _ => "We are not sure. Please read it with care.",
    };

    private string DecisionText => (Message.State, Message.HelperDecision) switch
    {
        (MessageState.Blocked, null) => "The checker blocked this automatically. The user never saw it.",
        (MessageState.Blocked, _) => "Done. You blocked this message. The user will never see it.",
        _ => "Done. You approved this message. It is now in the user's inbox.",
    };

    private string ConfirmText => Message.Confidence == Confidence.Low
        ? "Approve this message? The user will see it."
        : "We think this is risky. Approve it anyway? The user will see it.";

    private void AskConfirm() => _confirming = true;
    private void CancelConfirm() => _confirming = false;

    // Nothing is committed until the countdown ends. Leaving the page cancels it,
    // so the message stays held (fail closed).
    private async Task Start(string decision)
    {
        _confirming = false;
        _pending = decision;
        _secs = UndoSeconds;
        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        var token = _cts.Token;
        try
        {
            while (_secs > 0)
            {
                await Task.Delay(1000, token);
                _secs--;
                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
            return;
        }

        var chosen = _pending;
        _pending = null;
        if (chosen == "Blocked") await OnBlock.InvokeAsync();
        else if (chosen == "Approved") await OnApprove.InvokeAsync();
    }

    private void Undo()
    {
        _cts?.Cancel();
        _pending = null;
    }

    public void Dispose() => _cts?.Cancel();
}
