@implements IDisposable
@inject IGuardianService Guardian
@inject IBackstopApi Api

<article class="evidence" aria-labelledby="ev-title">
    <p class="evidence__status">
        <StatusBadge State="Message.State" ForHelper="true" />
    </p>
    <h1 id="ev-title">@Message.Subject</h1>
    <p class="evidence__who">From <strong>@Message.FromName</strong> <code>@Defang.ForHelper(Message.FromAddress)</code></p>

    @if (Message.State == MessageState.Held)
    {
        <div class="banner @(Message.Concern == Concern.Strong ? "banner--block" : "banner--check")">
            <Icon Name="alert" />
            <div>
                <p class="verdict__head">@VerdictHead</p>
                <p class="verdict__sub">@VerdictSub</p>
            </div>
        </div>
    }

    <p class="lead">@Message.Summary</p>
    @if (Message.State is MessageState.Held or MessageState.Blocked)
    {
        <WatchForTip Tip="@(Message.WatchFor ?? WatchFor.Fallback(null))" />
    }
    <div class="evidence__read"><ReadAloud Text="@Speech" /></div>

    @if (ShownFlags.Count > 0)
    {
        <section class="card" aria-labelledby="ev-flags">
            <h2 id="ev-flags">
                What looked wrong
                @if (Message.RulesScore > 0)
                {
                    <span class="card__meta">Rules score @Message.RulesScore</span>
                }
            </h2>
            <ul class="flags">
                @foreach (var f in ShownFlags)
                {
                    <li class="flag">
                        <span class="flag__icon"><Icon Name="@f.Icon" /></span>
                        <span>
                            <strong>@f.Title</strong>
                            <span class="flag__text">@f.Explanation</span>
                        </span>
                    </li>
                }
            </ul>
        </section>
    }

    @if (Message.SenderSignals.Count > 0)
    {
        <section class="card" aria-labelledby="ev-sender">
            <h2 id="ev-sender">Sender checks</h2>
            @if (!string.IsNullOrWhiteSpace(Message.ReplyTo))
            {
                <p class="preview-meta">Replies go to <code>@Defang.ForHelper(Message.ReplyTo)</code></p>
            }
            <SenderChecks Signals="Message.SenderSignals" />
        </section>
    }

    @if (Message.Links.Count > 0)
    {
        <details class="card fold">
            <summary>Link check (@Message.Links.Count)</summary>
            @foreach (var l in Message.Links)
            {
                <div class="linkcheck">
                    <p><Icon Name="link" /> <code>@l.DefangedUrl</code></p>
                    @if (l.Signals.Count == 0)
                    {
                        <p>No warning signs in the address.</p>
                    }
                    else
                    {
                        <ul>
                            @foreach (var s in l.Signals)
                            {
                                <li>@s</li>
                            }
                        </ul>
                    }
                </div>
            }
        </details>
    }

    <details class="card fold">
        <summary>The message</summary>
        <pre class="preview">@Defang.ForHelper(Message.Body)</pre>
    </details>

    @if (Message.State == MessageState.Held)
    {
        @* One tap decides. Nothing changes for the user until the undo window ends. *@
        <div class="actionbar" role="group" aria-label="Your decision">
            @if (_pend is { } p)
            {
                <div class="toast" role="status">
                    <Icon Name="hourglass" />
                    <span>@(p.Safe ? "Safe, letting it through" : "Not safe, blocking it") in @p.SecondsLeft @(p.SecondsLeft == 1 ? "second" : "seconds").</span>
                    <button type="button" class="btn btn-primary" @onclick="Undo"><Icon Name="arrow-left" /> Undo</button>
                </div>
            }
            else
            {
                <div class="actions actions--helper">
                    @if (Message.AwaitingScan)
                    {
                        <button type="button" class="btn btn-quiet" disabled="@_scanning" @onclick="Rescan">
                            <Icon Name="refresh" /> @(_scanning ? "Checking…" : "Check again")
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-primary" @onclick="@(() => Choose(true))">
                            <Icon Name="check" /> Safe, let it through
                        </button>
                    }
                    @* Block only stands out when the checker is very sure. When it is not sure, both choices weigh the same. *@
                    <button type="button" class="btn @(Message.Concern == Concern.Strong ? "btn-block" : "btn-quiet btn-danger")" @onclick="@(() => Choose(false))">
                        <Icon Name="cross" /> Not safe, block it
                    </button>
                    <div class="actions__links">
                        @if (!Message.CallRequested)
                        {
                            <button type="button" class="btn btn-text" @onclick="@(() => Guardian.CallFirst(Message.Id))"><Icon Name="phone" /> Call @UserName first</button>
                        }
                    </div>
                </div>
            }
            @if (_error is not null)
            {
                <p class="form-error" role="alert">@_error</p>
            }
            @if (Message.CallRequested)
            {
                <p class="call-note" role="status">
                    <span>You will call @UserName before you decide.</span>
                    <button type="button" class="btn btn-text" @onclick="@(() => Guardian.CancelCall(Message.Id))">Undo</button>
                </p>
            }
            else if (_undone)
            {
                <p class="call-note" role="status"><span>Undone. The message is still held.</span></p>
            }
        </div>
    }
    else
    {
        <div class="banner @(Message.State == MessageState.Blocked ? "banner--block" : "banner--safe")" role="status">
            <Icon Name="@(Message.State == MessageState.Blocked ? "cross" : "check")" />
            <p>@DecisionText</p>
        </div>
        <p class="actions"><a class="btn btn-primary" href="/helper"><Icon Name="arrow-left" /> Back to the queue</a></p>
    }
</article>

@code {
    [Parameter, EditorRequired] public MailMessage Message { get; set; } = default!;
    [Parameter] public EventCallback OnRescan { get; set; }

    private bool _scanning;

    // The explanation and the next step only, not the flags, the signals or the rules score.
    private string Speech => string.IsNullOrWhiteSpace(Message.Summary) ? "" : $"{VerdictHead} {Message.Summary} {(Message.Concern == Concern.Strong ? "We suggest you block it." : "Please read it with care.")}";

    // The one-line sender flag is left out when the "Sender checks" card lists the signals in full.
    private List<Flag> ShownFlags => Message.SenderSignals.Count > 0
        ? Message.Flags.Where(f => f.Title != MailAnalyzer.SenderFlagTitle).ToList()
        : Message.Flags;

    private async Task Rescan()
    {
        _scanning = true;
        try { await OnRescan.InvokeAsync(); }
        finally { _scanning = false; }
    }

    private string VerdictHead => Message.Concern switch
    {
        Concern.Strong => "This looks like a scam.",
        Concern.Some => "This might be a scam.",
        _ => "We cannot tell if this is safe.",
    };

    // When the checker could not finish, that is the first thing to say. The suggestion follows it.
    private string VerdictSub => (Message.AwaitingScan ? "The checker could not finish. " : "")
        + (Message.Concern == Concern.Strong ? "We suggest you block it." : "Please read it with care.");

    private string UserName => Api.Household.UserName;

    private string DecisionText => (Message.State, Message.HelperDecision) switch
    {
        (MessageState.Blocked, null) => $"The checker blocked this automatically. {UserName} never saw it.",
        (MessageState.Blocked, _) => $"Done. You blocked this message. {UserName} will never see it.",
        (MessageState.Cleared, null) => $"The checker cleared this message. {UserName} can read it.",
        _ => $"Done. You approved this message. It is now in {UserName}'s inbox.",
    };

    // The decision itself lives in the service. It waits out the undo window there, so leaving this page does not lose it,
    // and nothing is saved, or shown to the user, until the window ends.
    private PendingDecision? _pend;
    private string? _error;
    private bool _undone, _looping;
    private CancellationTokenSource? _cts;

    protected override void OnParametersSet()
    {
        _pend = Guardian.GetPending(Message.Id);
        if (_pend is not null) Watch();
    }

    private void Choose(bool safe)
    {
        _error = null;
        _undone = false;
        var r = Guardian.Propose(Message.Id, safe);
        if (!r.Ok) { _error = r.Error; return; }
        _pend = Guardian.GetPending(Message.Id);
        Watch();
    }

    private void Undo()
    {
        if (Guardian.Undo(Message.Id)) { _pend = null; _undone = true; }
        else _pend = Guardian.GetPending(Message.Id); // too late: it is being saved
    }

    // Counts the toast down, and shows the error if the decision could not be saved (the message stays held).
    private void Watch()
    {
        if (_looping) return;
        _looping = true;
        _cts = new CancellationTokenSource();
        _ = Loop(_cts.Token);
    }

    private async Task Loop(CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested)
            {
                await Task.Delay(500, token);
                _pend = Guardian.GetPending(Message.Id);
                if (_pend is null) _error = Guardian.TakeFailure(Message.Id);
                await InvokeAsync(StateHasChanged);
                if (_pend is null) break;
            }
        }
        catch (OperationCanceledException) { }
        finally { _looping = false; }
    }

    public void Dispose() => _cts?.Cancel();
}
