        <rect style="fill:var(--art-floor-2)" y="150" width="320" height="90" />
        <path class="ln ln--thin soft" d="M0 150H320M0 184H320M0 220H320" />
        <rect class="ln" style="fill:var(--art-glass)" x="30" y="28" width="104" height="72" rx="6" /><path class="ln ln--thin" d="M82 28V100" />
        <rect style="fill:var(--art-charcoal);opacity:.35" x="42" y="62" width="14" height="38" /><rect style="fill:var(--art-charcoal);opacity:.35" x="60" y="48" width="16" height="52" /><rect style="fill:var(--art-charcoal);opacity:.35" x="92" y="70" width="14" height="30" />
        <rect class="ln" style="fill:var(--art-coat)" x="188" y="32" width="100" height="62" rx="5" /><path class="ln ln--thin" d="M200 48h50M200 60h72M200 72h40" /><rect style="fill:var(--art-cloth-3)" x="262" y="44" width="16" height="12" rx="2" />
