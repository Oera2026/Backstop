        <circle class="art-sun" style="fill:var(--art-sun)" cx="270" cy="30" r="14" />
        <path style="fill:var(--art-grass-2)" d="M0 118 Q60 92 130 112 Q200 126 260 104 Q300 94 320 106 V140 H0Z" />
