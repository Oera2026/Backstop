        break;
    default: // "home"
        <rect style="fill:var(--art-wall)" width="320" height="152" />
        <rect style="fill:var(--art-floor)" y="150" width="320" height="90" />
        <path class="ln ln--thin soft" d="M0 150H320M0 180H320M0 214H320M80 150L50 240M200 150L220 240" />
