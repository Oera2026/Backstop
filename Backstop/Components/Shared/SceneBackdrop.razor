        <g class="ln ln--thin" style="fill:var(--art-glass)"><rect x="12" y="60" width="18" height="22" /><rect x="40" y="60" width="18" height="22" /><rect x="12" y="94" width="18" height="22" /><rect x="100" y="44" width="18" height="22" /><rect x="130" y="44" width="18" height="22" /><rect x="100" y="80" width="18" height="22" /><rect x="130" y="80" width="18" height="22" /><rect x="176" y="70" width="16" height="20" /><rect x="204" y="70" width="16" height="20" /><rect x="246" y="54" width="18" height="22" /><rect x="282" y="54" width="18" height="22" /></g>
