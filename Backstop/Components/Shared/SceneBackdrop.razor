@* The painted place behind the people. A fixed set of settings; colours are theme variables. 320 x 240. *@
@switch (Setting)
{
    case "clinic":
        <rect style="fill:var(--art-wall-2)" width="320" height="152" />
        <rect style="fill:var(--art-floor)" y="150" width="320" height="90" />
        <path class="ln ln--thin soft" d="M0 150H320M0 178H320M0 210H320M60 150L20 240M160 150V240M260 150L300 240" />
        <rect class="ln" style="fill:var(--art-glass)" x="214" y="28" width="80" height="70" rx="6" />
        <path class="ln ln--thin" d="M254 28V98M214 63H294" />
        <path class="art-beam" style="fill:var(--art-coat)" d="M214 98 L294 98 L316 150 L196 150Z" />
