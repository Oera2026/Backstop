@* One painted person, drawn at the feet (0,0), about 120 units tall. Only fixed keys choose the look, so nothing from the model
   is ever written out as markup. Colours are theme variables. Movement is CSS (see motion.css, "Story art"). *@
@{
    var skin = $"fill:var(--art-skin-{A.Skin})";
    var hair = $"fill:var(--art-hair-{A.HairColour})";
    var top = TopFill();
    var legs = LegsFill();
    var seated = A.Pose == "sit";
    var dy = seated ? 18 : 0;
    var scale = A.Age == "child" ? 0.74 : A.Age == "older" ? 0.96 : 1.0;
    var headScale = A.Age == "child" ? 1.2 : 1.0;
    var eyeX = Facing * 1.3;
    var eyeY = A.Mood == "thinking" ? -2.6 : -1;
    var doctor = A.Role == "doctor";
    var nurse = A.Role == "nurse";
    var shop = A.Role == "shopkeeper";
    var driver = A.Role == "driver";
}
<g transform="translate(@X @Y) scale(@scale.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))">
    <g class="art-in" style="animation-delay:@(Order * 0.45)s">
        <ellipse class="art-shadow" cx="0" cy="3" rx="24" ry="5" />

        @if (seated)
        {
            <g class="art-chair">
                <rect class="ln" style="fill:var(--art-wood)" x="-20" y="-64" width="40" height="44" rx="6" />
                <path class="ln" d="M-18 -20v20M18 -20v20" />
            </g>
        }

        <g class="@(A.Pose == "walk" ? "art-walk" : "art-idle")">
            @* legs *@
            <g transform="@(seated ? "scale(1 .55)" : "")">
                <g class="leg leg--l"><path class="ln" style="@legs" d="M-14 -42 L-13 -4 Q-13 0 -9 0 L-4 0 Q-2 0 -2 -4 L-1 -42 Z" /><ellipse class="ln" style="fill:var(--art-ink)" cx="-9" cy="0" rx="9" ry="4" /></g>
                <g class="leg leg--r"><path class="ln" style="@legs" d="M14 -42 L13 -4 Q13 0 9 0 L4 0 Q2 0 2 -4 L1 -42 Z" /><ellipse class="ln" style="fill:var(--art-ink)" cx="9" cy="0" rx="9" ry="4" /></g>
            </g>

            <g transform="translate(0 @dy)"><g class="art-body">
                @* neck and torso *@
                <rect class="ln" style="@skin" x="-4.5" y="-88" width="9" height="12" rx="3" />
                <path class="ln" style="@top" d="M-18 -78 Q-23 -58 -17 -38 L17 -38 Q23 -58 18 -78 Q0 -87 -18 -78Z" />
                @if (doctor)
                {
                    <path class="ln" style="fill:var(--art-cloth-6)" d="M-5 -80 L0 -62 L5 -80Z" />
                    <path class="ln" d="M-5 -80 L-9 -58M5 -80 L9 -58M0 -62 V-38" />
                    <path class="ln" style="fill:none" d="M-7 -79 Q-9 -58 0 -56 Q9 -58 7 -79" />
                    <circle class="ln" style="fill:var(--art-charcoal)" cx="0" cy="-54" r="3" />
                }
                else if (nurse)
                {
                    <path class="ln" style="@skin" d="M-6 -81 L0 -69 L6 -81Z" />
                    <rect class="ln" style="fill:var(--art-coat)" x="7" y="-64" width="8" height="5" rx="1" />
                }
                else if (shop)
                {
                    <path class="ln" style="fill:var(--art-coat)" d="M-12 -70 L12 -70 L16 -38 L-16 -38Z" />
                    <path class="ln" style="@skin" d="M-6 -81 Q0 -73 6 -81Z" />
                }
                else
                {
                    <path class="ln" style="@skin" d="M-6 -81 Q0 -72 6 -81Z" />
                }

                @* right arm (the viewer's right) *@
                <g transform="translate(19 -76)"><g class="@ArmRight()">
                    <path class="ln" style="@Sleeve()" d="M-5 -1 Q-7 20 -6 33 L6 33 Q7 20 5 -1 Z" />
                    <circle class="ln" style="@skin" cx="0" cy="38" r="5.5" />
                </g></g>
                @* left arm, which carries what is held *@
                <g transform="translate(-19 -76)"><g class="@ArmLeft()">
                    <path class="ln" style="@Sleeve()" d="M-5 -1 Q-7 20 -6 33 L6 33 Q7 20 5 -1 Z" />
                    <circle class="ln" style="@skin" cx="0" cy="38" r="5.5" />
                    @switch (A.Holding)
                    {
                        case "paper":
                            <g transform="rotate(8 0 44)"><rect class="ln" style="fill:var(--art-paper)" x="-8" y="30" width="16" height="22" rx="2" /><path class="ln" d="M-4 37h8M-4 42h8M-4 47h5" /></g>
                            break;
                        case "phone":
                            <rect class="ln" style="fill:var(--art-charcoal)" x="-5" y="30" width="10" height="18" rx="2.5" />
                            <rect style="fill:var(--art-glass)" x="-3" y="32" width="6" height="12" rx="1" />
                            break;
                        case "cup":
                            <path class="ln" style="fill:var(--art-coat)" d="M-6 36 h12 v9 q0 5 -6 5 q-6 0 -6 -5z" />
                            <path class="ln" style="fill:none" d="M6 38 q5 0 4 4 q-1 3 -4 3" />
                            break;
                        case "bag":
                            <path class="ln" style="fill:none" d="M-5 40 Q-6 30 0 30 Q6 30 5 40" />
                            <rect class="ln" style="fill:var(--art-cloth-@A.Colour)" x="-12" y="40" width="24" height="22" rx="4" />
                            break;
                    }
                </g></g>

                @* head *@
                <g transform="translate(0 -100) scale(@headScale.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))">
                    @if (A.Hair == "long")
                    {
                        <path class="ln" style="@hair" d="M-16 -2 Q-19 -23 0 -22 Q19 -23 16 -2 L19 22 Q0 27 -19 22Z" />
                    }
                    <circle class="ln" style="@skin" cx="-14" cy="1" r="3.2" />
                    <circle class="ln" style="@skin" cx="14" cy="1" r="3.2" />
                    <ellipse class="ln" style="@skin" cx="0" cy="0" rx="14" ry="16.5" />
                    @switch (A.Hair)
                    {
                        case "long":
                            <path class="ln" style="@hair" d="M-14.5 -5 Q-8 -19 0 -18 Q9 -19 14.5 -5 Q7 -12 0 -11.5 Q-8 -12 -14.5 -5Z" />
                            break;
                        case "curly":
                            <g class="ln" style="@hair">
                                <circle cx="-11" cy="-9" r="7" /><circle cx="-5" cy="-15" r="7" /><circle cx="3" cy="-17" r="7" /><circle cx="10" cy="-12" r="7" /><circle cx="13" cy="-5" r="5" /><circle cx="-14" cy="-3" r="5" />
                            </g>
                            break;
                        case "bun":
                            <circle class="ln" style="@hair" cx="0" cy="-22" r="7" />
                            <path class="ln" style="@hair" d="M-15 -3 Q-16 -19 0 -19 Q16 -19 15 -3 Q10 -11 0 -10 Q-10 -11 -15 -3Z" />
                            break;
                        case "bald":
                            <path class="ln" style="@hair" d="M-14.5 -4 Q-17 2 -14.5 7 Q-12 2 -13 -4Z" />
                            <path class="ln" style="@hair" d="M14.5 -4 Q17 2 14.5 7 Q12 2 13 -4Z" />
                            break;
                        default:
                            <path class="ln" style="@hair" d="M-15 -3 Q-17 -20 0 -19.5 Q17 -20 15 -3 Q11 -12 0 -11 Q-11 -12 -15 -3Z" />
                            break;
                    }
                    @if (driver)
                    {
                        <path class="ln" style="fill:var(--art-denim)" d="M-15.5 -6 Q-15.5 -23 0 -23 Q15.5 -23 15.5 -6 Z" />
                        <path class="ln" style="fill:var(--art-charcoal)" d="M-15.5 -6 H15.5 q0 5 -9 5 H-7 q-8.5 0 -8.5 -5Z" />
                    }

                    @* face *@
                    <g transform="translate(@eyeX.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) @eyeY.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))"><g class="art-eyes">
                        <ellipse style="fill:var(--art-ink)" cx="-5.5" cy="0" rx="1.8" ry="2.3" />
                        <ellipse style="fill:var(--art-ink)" cx="5.5" cy="0" rx="1.8" ry="2.3" />
                    </g></g>
                    <g class="ln ln--thin" style="fill:none">
                        @switch (A.Mood)
                        {
                            case "unsure":
                                <path d="M-8.5 -6.5 L-3 -9M8.5 -6.5 L3 -9" />
                                <path d="M-3.5 8 Q0 6.2 3.5 8" />
                                break;
                            case "thinking":
                                <path d="M-8 -7.5 Q-5.5 -9 -3 -7.5M3 -9.5 Q5.5 -11 8 -9.5" />
                                <path d="M-2 8 H2.5" />
                                break;
                            case "happy":
                                <path d="M-8 -7 Q-5.5 -9 -3 -7M3 -7 Q5.5 -9 8 -7" />
                                break;
                            default:
                                <path d="M-8 -6.5 Q-5.5 -8 -3 -6.5M3 -6.5 Q5.5 -8 8 -6.5" />
                                <path d="M-4 7 Q0 10 4 7" />
                                break;
                        }
                    </g>
                    @if (A.Mood == "happy")
                    {
                        <path class="ln ln--thin" style="fill:var(--art-coat)" d="M-6 5.5 Q0 13 6 5.5 Q0 7.5 -6 5.5Z" />
                        <circle style="fill:var(--art-cheek);opacity:.65" cx="-9.5" cy="5" r="3" />
                        <circle style="fill:var(--art-cheek);opacity:.65" cx="9.5" cy="5" r="3" />
                    }
                    @if (A.Pose == "talk")
                    {
                        <g transform="translate(0 8)"><ellipse class="art-mouth" style="fill:var(--art-ink)" cx="0" cy="0" rx="2.8" ry="2.2" /></g>
                    }
                    @if (A.Glasses)
                    {
                        <g class="ln ln--thin" style="fill:none"><circle cx="-5.5" cy="0" r="5" /><circle cx="5.5" cy="0" r="5" /><path d="M-0.5 0 H0.5" /></g>
                    }
                </g>
            </g></g>
        </g>

        @if (A.Pose == "talk")
        {
            <g class="art-bubble" transform="translate(@(Facing <= 0 ? 22 : -42) @(-132 + dy))">
                <path class="ln" style="fill:var(--art-coat)" d="M0 0 h26 a6 6 0 0 1 6 6 v8 a6 6 0 0 1 -6 6 h-14 l-6 6 v-6 h-6 a6 6 0 0 1 -6 -6 v-8 a6 6 0 0 1 6 -6z" transform="translate(-2 -2)" />
                <circle class="art-dot" style="fill:var(--art-ink)" cx="7" cy="8" r="1.8" />
                <circle class="art-dot art-dot--2" style="fill:var(--art-ink)" cx="14" cy="8" r="1.8" />
                <circle class="art-dot art-dot--3" style="fill:var(--art-ink)" cx="21" cy="8" r="1.8" />
            </g>
        }
    </g>
</g>

@code {
    [Parameter, EditorRequired] public Actor A { get; set; } = default!;
    [Parameter] public int X { get; set; } = 160;
    [Parameter] public int Y { get; set; } = 208;
    /// <summary>-1 looks left, 1 looks right, 0 looks straight on.</summary>
    [Parameter] public int Facing { get; set; }
    [Parameter] public int Order { get; set; }

    private string TopFill() => A.Role switch
    {
        "doctor" => "fill:var(--art-coat)",
        "nurse" => "fill:var(--art-scrubs)",
        "driver" => "fill:var(--art-denim)",
        "shopkeeper" => $"fill:var(--art-cloth-{A.Colour})",
        _ => $"fill:var(--art-cloth-{A.Colour})",
    };

    private string Sleeve() => A.Role switch
    {
        "doctor" => "fill:var(--art-coat)",
        "nurse" => "fill:var(--art-scrubs)",
        "driver" => "fill:var(--art-denim)",
        _ => $"fill:var(--art-cloth-{A.Colour})",
    };

    private string LegsFill() => A.Role switch
    {
        "nurse" => "fill:var(--art-scrubs)",
        "doctor" or "driver" or "teacher" => "fill:var(--art-charcoal)",
        _ => A.Colour % 2 == 0 ? "fill:var(--art-charcoal)" : "fill:var(--art-denim)",
    };

    // Resting arms hang. Waving lifts one arm. Talking lifts one hand a little. Walking swings both.
    private string ArmRight() => A.Pose switch { "wave" => "arm arm--wave", "talk" => "arm arm--talk", "walk" => "arm arm--swing-b", _ => "arm arm--rest-r" };
    private string ArmLeft() => A.Pose switch { "walk" => "arm arm--swing-a", _ => "arm arm--rest-l" };
}
