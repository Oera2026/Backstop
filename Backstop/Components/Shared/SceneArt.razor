@* An animated, hand-painted picture of a Scene. The scene is only fixed keys (already checked), so nothing from the model is
   ever written out as markup. The app lays everyone out, so people never overlap. Colours come from theme variables. *@
@{
    var cast = Scene.Cast ?? [];
    var things = Scene.Things ?? [];
    var outdoors = Scene.Setting is "bus_stop" or "park" or "street";
    var xs = cast.Count switch { 1 => new[] { 105 }, 2 => new[] { 85, 235 }, _ => new[] { 55, 160, 265 } };
    var gap = cast.Count switch { 1 => 235, 2 => 160, _ => -1 };
    var gapUsed = false;
}
<svg class="guidepic art" viewBox="0 0 320 240" role="img" aria-label="@Label">
    <defs>
        <filter id="sa-rough" x="-5%" y="-5%" width="110%" height="110%">
            <feTurbulence type="fractalNoise" baseFrequency="0.04" numOctaves="2" seed="4" result="n" />
            <feDisplacementMap in="SourceGraphic" in2="n" scale="2.6" xChannelSelector="R" yChannelSelector="G" />
        </filter>
        <filter id="sa-grain" x="0" y="0" width="100%" height="100%">
            <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="9" />
            <feColorMatrix values="0 0 0 0 0.35  0 0 0 0 0.28  0 0 0 0 0.2  0 0 0 0.9 -0.3" />
        </filter>
    </defs>
    <g style="filter:url(#sa-rough)">
        <SceneBackdrop Setting="@(Scene.Setting ?? "home")" />

        @foreach (var t in things)
        {
            switch (t)
            {
                case "door":
                    <g class="art-in" style="animation-delay:.1s"><rect class="ln" style="fill:var(--art-cloth-6)" x="270" y="60" width="38" height="92" rx="4" /><rect style="fill:var(--art-coat);opacity:.25" x="276" y="68" width="26" height="30" rx="3" /><circle class="ln" style="fill:var(--art-sun)" cx="278" cy="108" r="3.5" /></g>
                    break;
                case "clock":
                    <g class="art-in" style="animation-delay:.2s">
                        @if (outdoors) { <rect class="ln" style="fill:var(--art-charcoal)" x="157" y="46" width="6" height="106" rx="2" /> }
                        <circle class="ln" style="fill:var(--art-coat)" cx="160" cy="44" r="19" />
                        <path class="ln ln--thin" d="M160 44V32" /><path class="ln ln--thin art-hand" d="M160 44L169 49" />
                    </g>
                    break;
                case "plant":
                    <g class="art-sway art-sway--2" style="transform-origin:290px 190px">
                        <path style="fill:var(--art-leaf)" class="ln" d="M290 176 Q268 150 274 128 Q292 146 290 176Z M290 176 Q312 148 304 124 Q286 144 290 176Z M290 176 Q290 140 292 118 Q300 146 290 176Z" />
                    </g>
                    <path class="ln" style="fill:var(--art-cloth-2)" d="M276 174 H304 L300 204 H280Z" />
                    break;
                case "bus":
                    if (outdoors)
                    {
                        <g class="art-bus">
                            <rect class="ln" style="fill:var(--art-bus)" x="150" y="82" width="150" height="66" rx="12" />
                            <rect style="fill:var(--art-bus-2)" x="150" y="124" width="150" height="10" />
                            <g class="ln ln--thin" style="fill:var(--art-glass)"><rect x="162" y="92" width="28" height="22" rx="3" /><rect x="196" y="92" width="28" height="22" rx="3" /><rect x="230" y="92" width="28" height="22" rx="3" /><rect x="264" y="90" width="28" height="30" rx="3" /></g>
                            <circle class="ln" style="fill:var(--art-charcoal)" cx="190" cy="148" r="12" /><circle class="ln" style="fill:var(--art-coat)" cx="190" cy="148" r="4.5" />
                            <circle class="ln" style="fill:var(--art-charcoal)" cx="262" cy="148" r="12" /><circle class="ln" style="fill:var(--art-coat)" cx="262" cy="148" r="4.5" />
                        </g>
                    }
                    break;
                case "chair":
                    if (gap > 0 && !gapUsed)
                    {
                        gapUsed = true;
                        <g class="art-in" style="animation-delay:.3s" transform="translate(@gap 206)">
                            <rect class="ln" style="fill:var(--art-wood)" x="-18" y="-62" width="36" height="42" rx="5" />
                            <rect class="ln" style="fill:var(--art-cloth-4)" x="-22" y="-26" width="44" height="10" rx="4" />
                            <path class="ln" d="M-18 -16v16M18 -16v16" />
                        </g>
                    }
                    break;
                case "table":
                    if (gap > 0 && !gapUsed)
                    {
                        gapUsed = true;
                        <g class="art-in" style="animation-delay:.3s" transform="translate(@gap 206)">
                            <rect class="ln" style="fill:var(--art-wood)" x="-36" y="-40" width="72" height="9" rx="3" />
                            <path class="ln" d="M-30 -31V0M30 -31V0" />
                            <path class="ln" style="fill:var(--art-cloth-3)" d="M-8 -40 h16 l-2 -11 h-12z" />
                        </g>
                    }
                    break;
            }
        }

        @for (var i = 0; i < cast.Count; i++)
        {
            var facing = cast.Count == 1 ? 1 : xs[i] < 160 ? 1 : xs[i] > 160 ? -1 : 0;
            <StoryActor A="cast[i]" X="xs[i]" Y="208" Facing="facing" Order="i + 1" />
        }
    </g>
    @if (Scene.Light == "evening")
    {
        <rect width="320" height="240" style="fill:var(--art-evening);opacity:.22;mix-blend-mode:multiply" />
    }
    <rect width="320" height="240" style="filter:url(#sa-grain);opacity:.22;mix-blend-mode:multiply" pointer-events="none" />
</svg>

@code {
    [Parameter, EditorRequired] public Scene Scene { get; set; } = new();
    [Parameter] public string Label { get; set; } = "Picture for this part of the story";
}
