@implements IDisposable
@inject DemoTour Tour
@inject NavigationManager Nav

@* Turns the guide off and on. *@
<button type="button" class="guide-toggle" aria-pressed="@(Tour.Active ? "true" : "false")" aria-label="Guide" @onclick="Toggle"><Icon Name="question" /> <span class="guide-toggle__text">Guide</span></button>

@code {
    protected override void OnInitialized() => Tour.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void Toggle()
    {
        if (Tour.Active) { Tour.Close(); return; }
        // Start on this page's first slide. A page with no slides sends the visitor to slide 1.
        var here = Nav.ToBaseRelativePath(Nav.Uri);
        Tour.Start(DemoTour.SideOf(here));
        Tour.Follow(here);
        if (!DemoTour.Matches(Tour.Current, here) && Tour.PathForCurrent() is { } path) Nav.NavigateTo(path);
    }

    public void Dispose() => Tour.Changed -= OnChanged;
}
