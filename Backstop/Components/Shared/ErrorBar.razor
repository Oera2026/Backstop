@* Shown by Blazor when the page breaks. Blazor wires up the .reload and .dismiss controls. *@
<div id="blazor-error-ui" role="alert" data-nosnippet>
    <span class="errorbar__text">Something went wrong.</span>
    <button type="button" class="btn btn-primary reload"><Icon Name="refresh" /> Reload</button>
    <button type="button" class="dismiss" aria-label="Dismiss"><Icon Name="cross" /></button>
</div>
