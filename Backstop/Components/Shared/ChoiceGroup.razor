<div class="choice" role="radiogroup" aria-labelledby="@(Name)-q">
    <span id="@(Name)-q" class="choice__q @(HideLegend ? "sr-note" : "")">@if (!string.IsNullOrEmpty(Glyph)) {<span class="pic pic--blue" aria-hidden="true"><Icon Name="@Glyph" /></span>}<span>@Legend</span>@if (ShowNow) {<span class="choice__now">@Now</span>}</span>
    <div class="choice__options" style="--n:@Options.Count">
        @foreach (var (value, label) in Options)
        {
            var id = $"{Name}-{value}";
            <input type="radio" id="@id" name="@Name" checked="@(Value == value)" @onchange="@(() => OnPick.InvokeAsync(value))" />
            <label for="@id">@label</label>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Legend { get; set; } = "";
    [Parameter] public string Glyph { get; set; } = "";
    [Parameter] public bool HideLegend { get; set; }

    /// <summary>Shows the chosen word beside the question, so the setting can be read at a glance.</summary>
    [Parameter] public bool ShowNow { get; set; }
    private string Now => Options.FirstOrDefault(o => o.Value == Value).Label ?? "";
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter, EditorRequired] public string Value { get; set; } = "";
    [Parameter, EditorRequired] public IReadOnlyList<(string Value, string Label)> Options { get; set; } = [];
    [Parameter] public EventCallback<string> OnPick { get; set; }
}
