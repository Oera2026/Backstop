@implements IAsyncDisposable
@inject DemoTour Tour
@inject NavigationManager Nav
@inject IJSRuntime JS

@* Demo visitors only: a guide that goes through one side page by page, lighting up what it talks about. *@
<AuthorizeView Roles="@Roles.Demo">
    @if (Tour.Active)
    {
        var s = Tour.Current;
        <section class="tourcard" role="region" aria-label="Guide" aria-live="polite">
            <div class="tourcard__head">
                <p class="tourcard__title">@s.Title</p>
                <span class="tourcard__count">@(Tour.Index + 1) of @Tour.Steps.Count</span>
                <button type="button" class="btn btn-text tourcard__close" @onclick="Tour.Close" aria-label="Close guide"><Icon Name="cross" /></button>
            </div>
            <p class="tourcard__text">@s.Text</p>
            <div class="tourcard__actions">
                @if (!Tour.IsFirst)
                {
                    <button type="button" class="btn btn-quiet" @onclick="Back" aria-label="Previous slide"><Icon Name="arrow-left" /></button>
                }
                @if (Tour.IsLast)
                {
                    <button type="button" class="btn btn-primary" @onclick="Tour.Close">Done</button>
                }
                else
                {
                    <button type="button" class="btn btn-primary" @onclick="Next">@(s.Tap ? "Show me" : "Next") <Icon Name="arrow-right" /></button>
                }
            </div>
        </section>
    }
</AuthorizeView>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private string _key = "";
    private bool _isDemo;

    private string Here => Nav.ToBaseRelativePath(Nav.Uri);
    private static TourSide SideOf(string path) => path.StartsWith("helper", StringComparison.OrdinalIgnoreCase) ? TourSide.Helper : TourSide.User;

    protected override async Task OnInitializedAsync()
    {
        _isDemo = AuthState is not null && (await AuthState).User.IsInRole(Roles.Demo);
        Tour.Changed += OnChanged;
        Nav.LocationChanged += OnMoved;
        // Every load of the app starts the guide again, from its first slide, on the side being looked at.
        if (_isDemo && !Tour.Begun) { Tour.Begin(SideOf(Here)); return; }
        if (Tour.Side != SideOf(Here) && !DemoTour.Matches(Tour.Current, Here)) Tour.Start(SideOf(Here));
        Tour.Follow(Here);
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void OnMoved(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        Tour.Follow(Here);
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_isDemo) return;
        try
        {
            // The first slide may be on another page: go there.
            if (firstRender && Tour.Active && !DemoTour.Matches(Tour.Current, Here)) { Go(); return; }
            // Light up what this slide is about whenever the slide or the page changes.
            var key = Tour.Active ? $"{Tour.Side}|{Tour.Index}|{Here}" : "off";
            if (key == _key) return;
            _key = key;
            if (!Tour.Active) await JS.InvokeVoidAsync("backstopTour.hide");
            else await JS.InvokeVoidAsync("backstopTour.show", Tour.Current.Selector);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or InvalidOperationException or TaskCanceledException) { /* closed, or still drawing on the server */ }
    }

    // Goes to the page for the current slide, if it is not already there.
    private void Go()
    {
        var path = Tour.PathForCurrent();
        if (path is not null && !DemoTour.Matches(Tour.Current, Here)) Nav.NavigateTo(path);
    }

    private async Task Next()
    {
        var was = Tour.Current;
        Tour.Next();
        // Slides that say "tap this" are tapped for the visitor, so the next page opens the way a real tap would.
        if (was.Tap && await JS.InvokeAsync<bool>("backstopTour.tap", was.Selector)) return;
        Go();
    }

    private void Back() { Tour.Back(); Go(); }



    public async ValueTask DisposeAsync()
    {
        Tour.Changed -= OnChanged;
        Nav.LocationChanged -= OnMoved;
        if (!_isDemo) return;
        try { await JS.InvokeVoidAsync("backstopTour.hide"); } catch (Exception) { }
    }
}
