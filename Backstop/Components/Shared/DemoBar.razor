@implements IAsyncDisposable
@inject DemoTour Tour
@inject NavigationManager Nav
@inject IJSRuntime JS

@* A guide that goes through one side page by page, lighting up what it talks about. *@
    @if (_ready && !_framed && Tour.Active)
    {
        var s = Tour.Current;
        <section class="tourcard" role="region" aria-label="Guide" aria-live="polite">
            <ol class="tourcard__trail" aria-label="Where you are in the guide">
                @foreach (var place in Tour.Sections)
                {
                    <li class="@(place == s.Section ? "tourcard__place tourcard__place--on" : "tourcard__place")" aria-current="@(place == s.Section ? "step" : null)">@place</li>
                }
            </ol>
            <div class="tourcard__head">
                <p class="tourcard__title">@s.Title</p>
                <span class="tourcard__count">@(Tour.Index + 1) of @Tour.Steps.Count</span>
                <button type="button" class="btn btn-text tourcard__close" @onclick="Tour.Close" aria-label="Close guide"><Icon Name="cross" /></button>
            </div>
            <p class="tourcard__text">@s.Text</p>
            <div class="tourcard__actions">
                @if (!Tour.IsFirst)
                {
                    <button type="button" class="btn btn-quiet" @onclick="Back" aria-label="Previous slide"><Icon Name="arrow-left" /></button>
                }
                @if (Tour.IsLast)
                {
                    <button type="button" class="btn btn-primary" @onclick="Tour.Close">Done</button>
                }
                else
                {
                    <button type="button" class="btn btn-primary" @onclick="Next">@(s.Tap ? "Show me" : "Next") <Icon Name="arrow-right" /></button>
                }
            </div>
        </section>
    }

@code {
    private string _key = "", _saved = "";
    private bool _ready, _framed;

    private string Here => Nav.ToBaseRelativePath(Nav.Uri);
    private static TourSide SideOf(string path) => DemoTour.SideOf(path);

    protected override async Task OnInitializedAsync()
    {
        Tour.Changed += OnChanged;
        Nav.LocationChanged += OnMoved;
        // A new load of the page waits for the first render, to read where this tab left the guide.
        // A layout change in the same circuit just carries on.
        if (!Tour.Begun) return;
        _ready = true;
        if (Tour.Side != SideOf(Here) && !DemoTour.Matches(Tour.Current, Here)) Tour.Start(SideOf(Here));
        Tour.Follow(Here);
    }

    // Puts the guide back where this tab left it. Only the landing from the demo sign-in (?tour=1)
    // starts again and goes to slide 1. Anything else stays on the page the visitor is on.
    private async Task Resume()
    {
        var side = SideOf(Here);
        if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query).ContainsKey("tour"))
        {
            Tour.Start(side);
            Go();
            return;
        }
        if (DemoTour.TryParse(await JS.InvokeAsync<string?>("backstopTour.load"), out var savedSide, out var index, out var active))
            Tour.Restore(side, savedSide == side ? index : 0, active);
        else
            Tour.Start(side);
        // The guide follows the page, or keeps its place when the page has no slides.
        Tour.Follow(Here);
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void OnMoved(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        Tour.Follow(Here);
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender && !_ready)
            {
                // Inside a frame (the split screen on the demo panel) there is no guide.
                if (await JS.InvokeAsync<bool>("backstopTour.framed")) { _framed = true; return; }
                await Resume();
                _ready = true;
                StateHasChanged();
                return;
            }
            if (_framed || !_ready) return;
            // Keep this tab's place for a reload.
            var saved = Tour.Save();
            if (saved != _saved) { _saved = saved; await JS.InvokeVoidAsync("backstopTour.save", saved); }
            // Light up what this slide is about whenever the slide or the page changes.
            var key = Tour.Active ? $"{Tour.Side}|{Tour.Index}|{Here}" : "off";
            if (key == _key) return;
            _key = key;
            if (!Tour.Active) await JS.InvokeVoidAsync("backstopTour.hide");
            else await JS.InvokeVoidAsync("backstopTour.show", Tour.Current.Selector);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or InvalidOperationException or TaskCanceledException) { /* closed, or still drawing on the server */ }
    }

    // Goes to the page for the current slide, if it is not already there.
    private void Go()
    {
        var path = Tour.PathForCurrent();
        if (path is not null && !DemoTour.Matches(Tour.Current, Here)) Nav.NavigateTo(path);
    }

    private async Task Next()
    {
        var was = Tour.Current;
        Tour.Next();
        // Slides that say "tap this" are tapped for the visitor, so the next page opens the way a real tap would.
        if (was.Tap && await JS.InvokeAsync<bool>("backstopTour.tap", was.Selector)) return;
        Go();
    }

    private void Back() { Tour.Back(); Go(); }

    public async ValueTask DisposeAsync()
    {
        Tour.Changed -= OnChanged;
        Nav.LocationChanged -= OnMoved;
        try { await JS.InvokeVoidAsync("backstopTour.hide"); } catch (Exception) { }
    }
}
