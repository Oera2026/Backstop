@inject IJSRuntime JS
@inject IBackstopApi Api

@* Device settings, shared by the user's and the helper's Settings pages. Done goes back to whichever side opened it. *@
<div class="settings-head">
    <h1>Settings</h1>
</div>

<div class="settings">
    <section class="settings__group settings__group--read" aria-labelledby="set-read">
        <h2 id="set-read"><span class="pic pic--navy" aria-hidden="true"><Icon Name="book" /></span> Reading</h2>
        <div class="settings__list">
            <ChoiceGroup ShowNow="true" Legend="Size of the words" Glyph="type" Name="size" Value="@_s["size"]" OnPick="@(v => Set("size", v))"
                         Options="@(new[] { ("normal", "Normal"), ("large", "Large"), ("xlarge", "Extra large") })" />

            <ChoiceGroup ShowNow="true" Legend="Space between lines" Glyph="lines" Name="spacing" Value="@_s["spacing"]" OnPick="@(v => Set("spacing", v))"
                         Options="@(new[] { ("normal", "Normal"), ("roomy", "Roomy") })" />

            <ChoiceGroup ShowNow="true" Legend="Voice speed" Glyph="speaker" Name="rate" Value="@_s["rate"]" OnPick="@(v => Set("rate", v))"
                         Options="@(new[] { ("slow", "Slow"), ("normal", "Normal"), ("fast", "Fast") })" />
        </div>
    </section>

    <section class="settings__group settings__group--look" aria-labelledby="set-look">
        <h2 id="set-look"><span class="pic" aria-hidden="true"><Icon Name="contrast" /></span> Colours and movement</h2>
        <div class="settings__list">
            <ChoiceGroup ShowNow="true" Legend="Light or dark" Glyph="@(_s["theme"] == "dark" ? "moon" : "sun")" Name="theme" Value="@_s["theme"]" OnPick="@(v => Set("theme", v))"
                         Options="@(new[] { ("light", "Light"), ("dark", "Dark"), ("auto", "Like my device") })" />

            <ChoiceGroup ShowNow="true" Legend="Contrast" Glyph="contrast" Name="contrast" Value="@_s["contrast"]" OnPick="@(v => Set("contrast", v))"
                         Options="@(new[] { ("standard", "Standard"), ("high", "High") })" />

            <ChoiceGroup ShowNow="true" Legend="Movement" Glyph="motion" Name="motion" Value="@_s["motion"]" OnPick="@(v => Set("motion", v))"
                         Options="@(new[] { ("normal", "Normal"), ("calm", "None") })" />
        </div>
    </section>

</div>

<div class="settings-foot">
    <a class="btn btn-primary" href="@DoneHref"><Icon Name="check" /> Done</a>
    <button type="button" class="btn btn-quiet" @onclick="Reset"><Icon Name="refresh" /> Put everything back</button>
    @if (ShowWelcome)
    {
        <a class="btn btn-text" href="welcome">Show the welcome again</a>
    }
</div>

@code {
    [Parameter] public string DoneHref { get; set; } = "/";

    /// <summary>The welcome screens are for the user only.</summary>
    [Parameter] public bool ShowWelcome { get; set; }

    private Dictionary<string, string> _s = new()
    {
        ["size"] = "normal", ["theme"] = "light", ["contrast"] = "standard", ["spacing"] = "normal", ["motion"] = "normal", ["rate"] = "normal",
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _s = await JS.InvokeAsync<Dictionary<string, string>>("backstopSettings.get");
            StateHasChanged();
        }
        catch (Exception) { /* settings are a convenience; the page works without them */ }
    }

    private async Task Set(string key, string value)
    {
        _s[key] = value;
        try { await JS.InvokeAsync<object>("backstopSettings.set", key, value); } catch (Exception) { }
    }

    private async Task Reset()
    {
        try { _s = await JS.InvokeAsync<Dictionary<string, string>>("backstopSettings.reset"); } catch (Exception) { }
    }
}
