@page "/helper/write"
@layout HelperLayout
@inherits ModeComponentBase

<PageTitle>Write as @UserName – Backstop Helper</PageTitle>

@if (!Guardian.Allows(HelperCapability.SendAsUser))
{
    <h1>Write as @UserName</h1>
    <p class="form-error" role="alert">@UserName has not allowed you to send mail as them.</p>
}
else if (_sent is not null)
{
    <div class="banner banner--safe" role="status">
        <Icon Name="check" />
        <h1 class="banner__h">Done. Sent to @_sent.ToAddress as @UserName.</h1>
    </div>
    <p class="actions"><button type="button" class="btn btn-primary" @onclick="Another"><Icon Name="pen" /> Write another</button></p>
}
else
{
    <h1>Write as @UserName</h1>
    <div class="field">
        <label for="w-to">To</label>
        <input id="w-to" type="email" inputmode="email" @bind="_to" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="name@example.com" />
    </div>
    <div class="field">
        <label for="w-subject">Subject</label>
        <input id="w-subject" type="text" @bind="_subject" autocomplete="off" />
    </div>
    <div class="field">
        <label for="w-body">Message</label>
        <textarea id="w-body" rows="7" @bind="_body"></textarea>
    </div>
    @if (_error is not null)
    {
        <p class="form-error" role="alert">@_error</p>
    }
    <p class="actions"><button type="button" class="btn btn-primary" @onclick="Send"><Icon Name="send" /> Send as @UserName</button></p>
}

@code {
    private string _to = "", _subject = "", _body = "";
    private string? _error;
    private SentMessage? _sent;

    private void Send()
    {
        var r = Guardian.SendAsUser(_to, _subject, _body);
        _error = r.Refused;
        _sent = r.Message;
    }

    private void Another()
    {
        _to = _subject = _body = "";
        _sent = null;
    }
}
