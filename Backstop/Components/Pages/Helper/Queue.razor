@page "/helper"
@layout HelperLayout
@inherits ModeComponentBase

<PageTitle>Waiting – Backstop Helper</PageTitle>

<h1>Waiting for you</h1>

@{ var digest = Api.GetHelperDigest(); }

@if (digest.WaitingCount == 0)
{
    <div class="banner banner--safe" role="status">
        <Icon Name="check" />
        <p>Nothing to do right now. All clear.</p>
    </div>
}

@Section("Needs you now", "alert", digest.In(HelperGroup.Urgent))
@Section("To decide", "hourglass", digest.In(HelperGroup.Decide))
@Section("Calls to make", "phone", digest.In(HelperGroup.Calls))
@Section("To know", "eye", digest.In(HelperGroup.Info))

@if (Guardian.Allows(HelperCapability.SeeSharedMemories))
{
    <SharedMemories Cards="_memories" />
}
@if (Guardian.Allows(HelperCapability.SeeActivitySummary))
{
    <ActivityLog Entries="_activity" />
}

@code {
    private IReadOnlyList<MemoryCard> _memories = [];
    private IReadOnlyList<ActivityEntry> _activity = [];
    private bool _scanning;

    protected override Task OnInitializedAsync() => Load();
    protected override Task OnApiChangedAsync() => Load();
    protected override Task OnStoreChangedAsync() => Load();

    private async Task Load()
    {
        try
        {
            var memories = Api.GetSharedMemoriesAsync();
            var activity = Api.GetActivityAsync();
            await Task.WhenAll(memories, activity);
            _memories = memories.Result;
            _activity = activity.Result;
        }
        catch (BackstopApiException) { /* keep what is on screen */ }
    }

    private async Task Rescan()
    {
        _scanning = true;
        try { await Mail.RescanAsync(); }
        finally { _scanning = false; }
    }

    private static string Pic(string tone) => tone switch { "block" => "pic--block", "safe" => "pic--safe", "info" => "pic--blue", _ => "pic--check" };

    private RenderFragment Section(string heading, string icon, IReadOnlyList<HelperItem> items) => items.Count == 0 ? @<text></text> :
    @<section aria-labelledby="@SectionId(heading)">
        <h2 id="@SectionId(heading)" class="group-h"><Icon Name="@icon" /> @heading <span class="group-count">@items.Count</span></h2>
        <ul class="rows" aria-label="@heading">
            @foreach (var i in items)
            {
                <li>
                    @if (i.Href is not null && !i.CallRequested)
                    {
                        <a class="row" href="@i.Href">@Body(i)</a>
                    }
                    else if (i.Href is not null)
                    {
                        <div class="row row--static">
                            <a class="row__link" href="@i.Href">@Body(i)</a>
                            <button type="button" class="btn btn-quiet" @onclick="@(() => Called(i.Id))"><Icon Name="phone" /> I called</button>
                        </div>
                    }
                    else
                    {
                        <div class="row row--static @(i.Kind == HelperItemKind.NewPerson ? "row--notice" : "")">
                            @Body(i)
                            @Actions(i)
                        </div>
                    }
                </li>
            }
        </ul>
    </section>;

    private static string SectionId(string heading) => "g-" + heading.Replace(' ', '-').ToLowerInvariant();

    private RenderFragment Body(HelperItem i) =>
    @<text>
        <span class="pic @Pic(i.Tone)" aria-hidden="true"><Icon Name="@i.Icon" /></span>
        <span class="row__main">
            <span class="row__kind">@i.Label</span>
            <span class="row__from">@i.Title</span>
            <span class="row__subject">@i.Detail</span>
            @if (i.Preview.Length > 0)
            {
                <span class="row__preview">@i.Preview</span>
            }
            @if (i.CallRequested)
            {
                <span class="row__call"><Icon Name="phone" /> You said you would call</span>
            }
        </span>
        <span class="row__side">
            @if (i.Word.Length > 0)
            {
                <span class="badge badge--@i.Tone"><Icon Name="@i.Icon" /><span>@i.Word</span></span>
            }
            @if (i.At != default && i.Kind != HelperItemKind.Checker)
            {
                <span class="row__time">@Clock.When(i.At)</span>
            }
        </span>
    </text>;

    private RenderFragment Actions(HelperItem i) => i.Kind switch
    {
        HelperItemKind.Outgoing =>
            @<text>
                <button type="button" class="btn btn-primary" @onclick="@(() => Guardian.ApproveOutgoing(i.Id))"><Icon Name="check" /> Send it</button>
                <button type="button" class="btn btn-quiet" @onclick="@(() => Guardian.BlockOutgoing(i.Id))"><Icon Name="cross" /> Do not send</button>
            </text>,
        HelperItemKind.NewPerson =>
            @<button type="button" class="btn btn-quiet" @onclick="@(() => Guardian.DismissNotice(i.Id))"><Icon Name="check" /> Got it</button>,
        HelperItemKind.Help =>
            @<button type="button" class="btn btn-quiet" @onclick="@(() => Api.ResolveHelpRequest(i.Id))"><Icon Name="check" /> I helped</button>,
        HelperItemKind.Checker =>
            @<button type="button" class="btn btn-quiet" disabled="@_scanning" @onclick="Rescan"><Icon Name="refresh" /> @(_scanning ? "Checking…" : "Check again")</button>,
        _ => @<text></text>,
    };

    private void Called(string id) => Api.MarkCalled(id);
}
