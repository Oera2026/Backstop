@page "/helper/messages"
@layout HelperLayout
@inherits ModeComponentBase
@using Backstop.Services.Api.Fixtures

<PageTitle>Messages – Backstop Helper</PageTitle>

<h1>Messages</h1>

@if (_problem is not null)
{
    <ErrorState Message="@_problem" OnRetry="Load" />
}
else if (_held is null)
{
    <LoadingState Text="Getting messages…" />
}
else
{
    <div class="msgs">
        <ul class="msgs__list" aria-label="Chats">
            @foreach (var p in Api.ChatPeople)
            {
                var mine = p.Id == ChatFixtures.TrustedId;
                var waiting = _held.Count(h => h.From.Id == p.Id);
                <li>
                    <button type="button" class="row row--button @(_selected == p.Id ? "row--on" : "")" aria-current="@(_selected == p.Id ? "true" : null)" @onclick="@(() => Pick(p.Id))">
                        @if (mine)
                        {
                            <ProfileAvatar Profile="Api.GetProfile(ProfileRole.User)" ShowStatus="true" />
                        }
                        else
                        {
                            <span class="pic pic--blue" aria-hidden="true"><Icon Name="@(p.Role == PersonRole.Helper ? "heart" : "people")" /></span>
                        }
                        <span class="row__main">
                            <span class="row__from">@(mine ? UserName : p.Name)</span>
                            <span class="row__subject">@(mine ? "You and " + UserName : p.Relationship)</span>
                        </span>
                        @if (mine)
                        {
                            <PresenceTag Presence="Api.GetProfile(ProfileRole.User).Presence" />
                        }
                        @if (waiting > 0)
                        {
                            <span class="msgs__tag"><Icon Name="hourglass" /> @waiting to check</span>
                        }
                    </button>
                </li>
            }
        </ul>

        <section class="msgs__pane" aria-label="@PaneTitle">
            <h2>@PaneTitle</h2>

            @foreach (var h in _held.Where(h => h.From.Id == _selected))
            {
                <div class="held" role="group" aria-label="Message waiting for you">
                    <p class="held__verdict"><Icon Name="hourglass" /> @VerdictCard.WordFor(h.Verdict)@(h.Flags.Count > 0 ? $": {h.Flags[0].Title.ToLowerInvariant()}" : "")</p>
                    <p class="held__text">@h.Preview</p>
                    <p class="held__why">@h.Reason</p>
                    <div class="held__actions">
                        <button type="button" class="btn btn-primary" disabled="@_busy" @onclick="@(() => Decide(h.Id, ReviewDecision.Release))"><Icon Name="check" /> Let it through</button>
                        <button type="button" class="btn btn-quiet" disabled="@_busy" @onclick="@(() => Decide(h.Id, ReviewDecision.Block))"><Icon Name="cross" /> Block</button>
                    </div>
                </div>
            }

            @if (_logProblem is not null)
            {
                <p class="form-error" role="alert">@_logProblem</p>
            }
            else
            {
                <ChatLog Messages="_log" Flip="@(!IsMine)" Label="@PaneTitle" EmptyText="No messages yet." />
            }

            @if (IsMine)
            {
                <ChatComposer Label="@($"Message to {UserName}")" OnSend="Send" />
            }
        </section>
    </div>

    <section class="card people" aria-labelledby="people-h">
        <h2 id="people-h">People @UserName can message</h2>
        <ul class="rows rows--compact" aria-label="People on the list">
            @foreach (var p in Api.ChatPeople.Where(p => p.Id != ChatFixtures.TrustedId))
            {
                <li>
                    <div class="row row--static">
                        <span class="pic pic--blue" aria-hidden="true"><Icon Name="@(p.Role == PersonRole.Helper ? "heart" : "people")" /></span>
                        <span class="row__main">
                            <span class="row__from">@p.Name</span>
                            <span class="row__subject">@p.Relationship</span>
                        </span>
                        <button type="button" class="btn btn-quiet" @onclick="@(() => RemovePerson(p.Id))"><Icon Name="minus" /> Take off</button>
                    </div>
                </li>
            }
        </ul>
        <div class="field">
            <label for="np-name">Name</label>
            <input id="np-name" type="text" @bind="_newName" autocomplete="off" />
        </div>
        <div class="field">
            <label for="np-rel">Who they are</label>
            <input id="np-rel" type="text" @bind="_newRel" autocomplete="off" placeholder="Friend from church" />
        </div>
        @if (_peopleProblem is not null)
        {
            <p class="form-error" role="alert">@_peopleProblem</p>
        }
        <p class="actions"><button type="button" class="btn btn-quiet" @onclick="AddPerson"><Icon Name="plus" /> Add to the list</button></p>
    </section>
}

@code {
    private IReadOnlyList<HeldChat>? _held;
    private IReadOnlyList<ChatMessage> _log = [];
    private string? _selected;
    private string? _problem;
    private string? _logProblem;
    private bool _busy;
    private string _newName = "", _newRel = "";
    private string? _peopleProblem;

    private void AddPerson()
    {
        try
        {
            Api.AddChatPerson(_newName, _newRel);
            _newName = _newRel = "";
            _peopleProblem = null;
        }
        catch (BackstopApiException ex) { _peopleProblem = ex.Message; }
    }

    private void RemovePerson(string id)
    {
        try
        {
            Api.RemoveChatPerson(id);
            if (_selected == id) _selected = ChatFixtures.TrustedId;
            _peopleProblem = null;
        }
        catch (BackstopApiException ex) { _peopleProblem = ex.Message; }
    }

    private bool IsMine => _selected == ChatFixtures.TrustedId;

    private string PaneTitle => IsMine
        ? $"Chat with {UserName}"
        : $"{UserName} and {Api.ChatPeople.FirstOrDefault(p => p.Id == _selected)?.Name}";

    protected override Task OnInitializedAsync() => Load();
    protected override Task OnApiChangedAsync() => Load();

    private async Task Load()
    {
        _problem = null;
        try
        {
            _held = await Api.GetHeldChatsAsync();
            // Open on whoever needs a decision first, otherwise on the helper's own chat.
            _selected ??= _held.FirstOrDefault()?.From.Id ?? ChatFixtures.TrustedId;
            await LoadLog();
        }
        catch (BackstopApiException ex) { _problem = ex.Message; }
    }

    private async Task LoadLog()
    {
        _logProblem = null;
        try { _log = await Api.GetChatLogAsync(_selected!); }
        catch (BackstopApiException ex) { _log = []; _logProblem = ex.Message; }
    }

    private async Task Pick(string id)
    {
        _selected = id;
        await LoadLog();
    }

    private async Task Decide(string id, ReviewDecision decision)
    {
        if (_busy) return;
        _busy = true;
        try { await Api.ResolveHeldChatAsync(id, decision); await Load(); }
        catch (BackstopApiException ex) { _problem = ex.Message; }
        finally { _busy = false; }
    }

    private async Task Send(string text)
    {
        await Api.SendChatAsHelperAsync(text);
        await LoadLog();
    }
}
