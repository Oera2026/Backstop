@page "/demo"
@layout DemoLayout
@inherits LiveComponentBase
@inject IBackstopApi Api
@inject MockApiOptions ApiOptions
@inject IDemoControl Demo

<PageTitle>Demo panel – Backstop</PageTitle>

<h1>Demo panel</h1>
<p class="lead">Pick a made-up email and watch Backstop check it. Everything here is pretend.</p>

<section class="card" aria-labelledby="sim-title">
    <h2 id="sim-title">Simulate incoming email</h2>
    <div class="field">
        <label for="scenario">Scenario</label>
        <select id="scenario" @bind="_scenarioId" disabled="@_running">
            @foreach (var s in Mail.Scenarios)
            {
                <option value="@s.Id">@s.Title</option>
            }
            <option value="@Own">Write my own email</option>
        </select>
        @if (_scenarioId != Own)
        {
            <p class="hint">@Current!.Description</p>
        }
    </div>
    @if (_scenarioId == Own)
    {
        <div class="field">
            <label for="own-from">From (made-up address, like sam@example.org)</label>
            <input id="own-from" type="email" @bind="_ownFrom" disabled="@_running" autocomplete="off" />
        </div>
        <div class="field">
            <label for="own-subject">Subject</label>
            <input id="own-subject" type="text" @bind="_ownSubject" maxlength="200" disabled="@_running" autocomplete="off" />
        </div>
        <div class="field">
            <label for="own-body">Message</label>
            <textarea id="own-body" rows="5" @bind="_ownBody" maxlength="5000" disabled="@_running"></textarea>
        </div>
    }
    <div class="field field--check">
        <input id="fail" type="checkbox" @bind="_fail" disabled="@_running" />
        <label for="fail">Make the checker crash (shows that errors are held, never let through)</label>
    </div>
    <div class="actions">
        <button type="button" class="btn btn-primary" @onclick="Run" disabled="@_running">
            <Icon Name="mail" /> @(_running ? "Checking…" : "Simulate incoming email")
        </button>
        <input id="reset-code" type="password" @bind="_resetCode" autocomplete="off" aria-label="Reset code" placeholder="Reset code" disabled="@_running" />
        <button type="button" class="btn btn-quiet" @onclick="ResetDemo" disabled="@_running">
            <Icon Name="refresh" /> Reset demo
        </button>
    </div>
    @if (_resetProblem is not null)
    {
        <p class="form-error" role="alert">@_resetProblem</p>
    }
</section>

<section class="card" aria-labelledby="pipe-title">
    <h2 id="pipe-title">Checking steps</h2>
    <PipelineTimeline Tiers="_tiers" />
    <div class="outcome" role="status">
        @if (_result is not null)
        {
            <StatusBadge State="_result.State" ForHelper="true" />
            <p>@OutcomeText</p>
        }
    </div>
</section>

<section class="card" aria-labelledby="modes-title">
    <h2 id="modes-title">Check, Show me, Explain and Remember</h2>
    <p>Open an example in the user view:</p>
    <ul class="chips">
        <li><a class="chip" href="check?example=giftcard">Check: gift card scam</a></li>
        <li><a class="chip" href="check?example=friend">Check: "friend" conversation</a></li>
        <li><a class="chip" href="check?example=parcel">Check: parcel link</a></li>
        <li><a class="chip" href="check?example=safe">Check: safe message</a></li>
        <li><a class="chip" href="explain?example=letter">Explain: council letter</a></li>
        <li><a class="chip" href="show-me?goal=Set%20the%20washing%20machine">Show me: washing machine</a></li>
        <li><a class="chip" href="show-me?goal=Make%20the%20bed">Show me: make the bed</a></li>
        <li><a class="chip" href="show-me?goal=Fill%20in%20the%20council%20form">Show me: fill in a form</a></li>
        <li><a class="chip" href="remember">Remember</a></li>
    </ul>
    <div class="field field--check">
        <input id="api-fail" type="checkbox" checked="@ApiOptions.FailRequests" @onchange="e => ApiOptions.FailRequests = (bool)e.Value!" />
        <label for="api-fail">Make these modes fail (shows each screen's error state)</label>
    </div>
    <div class="actions">
        <button type="button" class="btn btn-quiet" @onclick="Api.ClearMemories"><Icon Name="trash" /> Empty Remember</button>
    </div>
</section>

<section class="split-controls">
    <button type="button" class="btn btn-quiet" aria-pressed="@_split.ToString().ToLowerInvariant()" @onclick="() => _split = !_split">
        <Icon Name="@(_split ? "check" : "circle")" /> Side by side: @(_split ? "on" : "off")
    </button>
</section>

@if (_split)
{
    <section class="split" aria-label="User and helper side by side">
        <div class="split__pane">
            <h2>What the user sees</h2>
            <iframe title="User view" src="/" loading="lazy"></iframe>
        </div>
        <div class="split__pane">
            <h2>What the helper sees</h2>
            <iframe title="Helper view" src="/helper" loading="lazy"></iframe>
        </div>
    </section>
}

@code {
    private string _scenarioId = MockData.Scenarios[0].Id;
    private bool _fail, _running, _split = true;
    private MailMessage? _result;
    private TierResult[] _tiers = Fresh();

    private const string Own = "own";
    private string _ownFrom = "sam@example.org", _ownSubject = "", _ownBody = "";

    private Scenario? Current => Mail.Scenarios.FirstOrDefault(s => s.Id == _scenarioId);

    private static TierResult[] Fresh() =>
        [.. MockData.TierNames.Select(n => new TierResult(n, TierStatus.Pending, "Waiting"))];

    private string OutcomeText => _result?.State switch
    {
        MessageState.Cleared => "Cleared. It is now in the user's inbox.",
        MessageState.Blocked => "Blocked. The user never sees it.",
        _ => "Held. It is in the helper's queue. The user only sees a count.",
    };

    private async Task Run()
    {
        if (_scenarioId == Own && string.IsNullOrWhiteSpace(_ownBody)) return;
        _running = true;
        _result = null;
        _tiers = Fresh();
        try
        {
            void OnTier(int i, TierResult r)
            {
                _tiers[i] = r;
                _ = InvokeAsync(StateHasChanged);
            }
            _result = _scenarioId == Own
                ? await Mail.ReceiveAsync(new InboundMail(_ownFrom.Trim(), _ownFrom.Trim(), _ownSubject.Trim(), _ownBody), _fail, OnTier)
                : await Mail.ReceiveAsync(_scenarioId, _fail, OnTier);
        }
        finally
        {
            _running = false;
        }
    }

    private string _resetCode = "";
    private string? _resetProblem;

    private void ResetDemo()
    {
        var reset = Demo.Reset(_resetCode);
        _resetCode = "";
        _resetProblem = reset.Problem;
        if (!reset.Done) return;
        _fail = false;
        _result = null;
        _tiers = Fresh();
    }
}
