@page "/login"
@layout LoginLayout
@inject NavigationManager Nav

<PageTitle>Welcome – Backstop</PageTitle>

<h1>Welcome to Backstop</h1>
<p class="lead">Email that is checked before you see it. See how it works.</p>

<ul class="sidecards">
    <li>
        <a class="sidecard" href="/account/demo?side=user" data-enhance-nav="false">
            <span class="pic pic--navy" aria-hidden="true"><Icon Name="user" /></span>
            <span class="sidecard__title">See the user's side</span>
            <span class="sidecard__text">Reads and writes messages.</span>
            <span class="sidecard__go">Start <Icon Name="arrow-right" /></span>
        </a>
    </li>
    <li>
        <a class="sidecard sidecard--helper" href="/account/demo?side=helper" data-enhance-nav="false">
            <span class="pic pic--safe" aria-hidden="true"><Icon Name="people" /></span>
            <span class="sidecard__title">See the helper's side</span>
            <span class="sidecard__text">Decides on held messages.</span>
            <span class="sidecard__go">Start <Icon Name="arrow-right" /></span>
        </a>
    </li>
</ul>
<p class="login-try"><a class="btn btn-quiet" href="/try"><Icon Name="inspect" /> Check an email yourself</a></p>

<details class="login-existing" open="@(Error)">
    <summary>I have an account</summary>
    @if (ErrorFlag == "wait")
    {
        <p class="form-error" role="alert">That is a lot of tries. Please wait a minute and try again.</p>
    }
    else if (Error)
    {
        <p class="form-error" role="alert">That email or password is not right. Please try again.</p>
    }
    <form method="post" action="/account/login" class="login">
        <AntiforgeryToken />
        <div class="field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" autocomplete="username" maxlength="200" value="@_email" required />
        </div>
        <div class="field">
            <label for="password">Password</label>
            <input id="password" name="password" type="password" autocomplete="current-password" maxlength="200" required />
        </div>
        <div class="field field--check">
            <input id="show-pw" type="checkbox" data-show-password="password" />
            <label for="show-pw">Show my password</label>
        </div>
        <div class="actions">
            <button type="submit" class="btn btn-primary">Sign in</button>
        </div>
    </form>
</details>

@code {
    [SupplyParameterFromQuery(Name = "error")] private string? ErrorFlag { get; set; }
    private bool Error => ErrorFlag is not null;

    [CascadingParameter] private HttpContext? Http { get; set; }
    private string _email = "";

    // A wrong password brings the person back here. The email they typed comes back in a short cookie, once.
    protected override void OnInitialized()
    {
        if (Http is { Response.HasStarted: false } http && http.Request.Cookies.TryGetValue(CookieName, out var saved))
        {
            if (Error && saved.Length <= 200) _email = saved;
            http.Response.Cookies.Delete(CookieName, new CookieOptions { Path = "/login" });
        }
    }

    private const string CookieName = "backstop.login-email";
}
