@page "/helper-access"
@inherits ModeComponentBase

<PageTitle>What my helper can do – Backstop</PageTitle>
<BackLink Href="settings" Text="Back to settings" />

@if (_step == "custom")
{
    <h1>Pick what @Helper can do</h1>
    <ul class="rows" aria-label="What @Helper can do">
        @foreach (var (cap, label) in Choices)
        {
            var on = _custom.HasFlag(cap);
            <li>
                <button type="button" class="row row--button @(on ? "row--on" : "")" role="switch" aria-checked="@(on ? "true" : "false")" @onclick="@(() => Toggle(cap))">
                    <span class="pic @(on ? "pic--safe" : "pic--blue")" aria-hidden="true"><Icon Name="@(on ? "check" : "minus")" /></span>
                    <span class="row__main"><span class="row__from">@label</span></span>
                    <span class="row__side"><span class="badge badge--@(on ? "safe" : "check")"><Icon Name="@(on ? "check" : "minus")" /><span>@(on ? "Yes" : "No")</span></span></span>
                </button>
            </li>
        }
    </ul>
    <div class="actions">
        <button type="button" class="btn btn-primary" @onclick="SaveCustom"><Icon Name="check" /> Save</button>
        <button type="button" class="btn btn-quiet" @onclick="@(() => _step = "pick")"><Icon Name="arrow-left" /> Go back</button>
    </div>
}
else if (_step == "admin")
{
    <h1>Give @Helper full access?</h1>
    <div class="banner banner--check" role="alert">
        <Icon Name="alert" />
        <p>@Helper will be able to read your mail, see everything you do, and send mail as you.</p>
    </div>
    <div class="actions">
        <button type="button" class="btn btn-primary" @onclick="@(() => _step = "pick")"><Icon Name="arrow-left" /> No, go back</button>
        <button type="button" class="btn btn-quiet" @onclick="@(() => Apply(new HelperPermissions(HelperTier.Administrator)))"><Icon Name="check" /> Yes, give full access</button>
    </div>
}
else
{
    <h1>What can @Helper do?</h1>
    @if (_done is not null)
    {
        <p class="done-note" role="status"><Icon Name="check" /> @_done</p>
    }
    <ul class="rows" aria-label="Choose how much @Helper can do">
        @foreach (var (tier, label, text, icon) in Tiers)
        {
            var on = Api.HelperAccess.Tier == tier;
            <li>
                <button type="button" class="row row--button @(on ? "row--on" : "")" aria-pressed="@(on ? "true" : "false")" @onclick="@(() => Pick(tier))">
                    <span class="pic @(on ? "pic--safe" : "pic--blue")" aria-hidden="true"><Icon Name="@(on ? "check" : icon)" /></span>
                    <span class="row__main">
                        <span class="row__from">@label</span>
                        <span class="row__subject">@text</span>
                    </span>
                </button>
            </li>
        }
    </ul>
}

@code {
    private string _step = "pick";
    private string? _done;
    private HelperCapability _custom;

    private static readonly (HelperTier Tier, string Label, string Text, string Icon)[] Tiers =
    [
        (HelperTier.Minimal, "Only risky mail", "They hear about risky mail and decide it.", "eye"),
        (HelperTier.Standard, "Standard", "Also what I ask in Check, memories I share, and recent activity.", "user"),
        (HelperTier.Custom, "I choose", "I pick each thing.", "lines"),
        (HelperTier.Administrator, "Everything", "They can read my mail and send mail as me.", "people"),
    ];

    private static readonly (HelperCapability Cap, string Label)[] Choices =
    [
        (HelperCapability.SeeCheckRequests, "What I ask in Check"),
        (HelperCapability.SeeSharedMemories, "Memories I share"),
        (HelperCapability.SeeActivitySummary, "Recent activity"),
        (HelperCapability.SeeClearedMail, "Mail I can read"),
        (HelperCapability.SeeChats, "My chats"),
        (HelperCapability.SeeFullActivity, "Everything I do"),
        (HelperCapability.SendAsUser, "Send mail as me"),
    ];

    private void Pick(HelperTier tier)
    {
        _done = null;
        switch (tier)
        {
            case HelperTier.Administrator: _step = "admin"; break;
            case HelperTier.Custom:
                _custom = Api.HelperAccess.Tier == HelperTier.Custom ? Api.HelperAccess.Custom : HelperPermissions.For(HelperTier.Standard) & ~HelperCapability.Floor;
                _step = "custom";
                break;
            default: Apply(new HelperPermissions(tier)); break;
        }
    }

    private void Toggle(HelperCapability cap) => _custom ^= cap;

    private void SaveCustom() => Apply(new HelperPermissions(HelperTier.Custom, _custom & ~HelperCapability.Floor));

    private void Apply(HelperPermissions access)
    {
        Api.SetHelperAccess(access);
        _done = $"Done. {Helper} now has {AccessName(access.Tier)}.";
        _step = "pick";
    }

    private static string AccessName(HelperTier t) => t switch
    {
        HelperTier.Minimal => "only risky mail",
        HelperTier.Standard => "standard access",
        HelperTier.Custom => "the access you picked",
        _ => "full access",
    };
}
