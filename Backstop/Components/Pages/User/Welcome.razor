@page "/welcome"
@layout WelcomeLayout
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Welcome – Backstop</PageTitle>

@if (_step == 1)
{
    <h1 @ref="_heading" tabindex="-1">Welcome to Backstop</h1>
    <p class="lead">Choose what is easiest for you to read. The page changes as you pick.</p>
    <ChoiceGroup Legend="Size of the words" Name="w-size" Value="@_s["size"]" OnPick="@(v => Pick("size", v))"
                 Options="@(new[] { ("normal", "Normal"), ("large", "Large"), ("xlarge", "Extra large") })" />
    <ChoiceGroup Legend="Colours" Name="w-contrast" Value="@_s["contrast"]" OnPick="@(v => Pick("contrast", v))"
                 Options="@(new[] { ("standard", "Standard"), ("high", "High contrast") })" />
    <div class="actions">
        <button type="button" class="btn btn-primary" @onclick="Next">Next <Icon Name="arrow-right" /></button>
        <button type="button" class="btn btn-text" @onclick="Finish">Skip</button>
    </div>
}
else
{
    <BackLink OnClick="Back" Text="Back" />
    <h1 @ref="_heading" tabindex="-1">You are ready</h1>
    <p class="lead">What would you like to do first?</p>
    <div class="actions">
        <button type="button" class="btn btn-primary" @onclick="@(() => Done("/inbox"))"><Icon Name="mail" /> Open my inbox</button>
        <button type="button" class="btn btn-quiet" @onclick="@(() => Done("compose"))"><Icon Name="pen" /> Write a message</button>
    </div>
}

@code {
    private const int Steps = 2;

    private int _step = 1;
    private bool _focus;
    private ElementReference _heading;
    private Dictionary<string, string> _s = new() { ["size"] = "normal", ["contrast"] = "standard" };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var saved = await JS.InvokeAsync<Dictionary<string, string>>("backstopSettings.get");
                _s = new Dictionary<string, string>(saved);
                StateHasChanged();
            }
            catch (Exception) { /* the screens work without saved settings */ }
        }
        // Move the reader to the new heading so a screen reader says what the step is.
        if (_focus)
        {
            _focus = false;
            try { await _heading.FocusAsync(); } catch (Exception) { }
        }
    }

    private async Task Pick(string key, string value)
    {
        _s[key] = value;
        try { await JS.InvokeAsync<object>("backstopSettings.set", key, value); } catch (Exception) { }
    }

    private void Go(int step) { _step = Math.Clamp(step, 1, Steps); _focus = true; }
    private void Next() => Go(_step + 1);
    private void Back() => Go(_step - 1);

    private Task Finish() => Done("/inbox");

    private async Task Done(string to)
    {
        try { await JS.InvokeVoidAsync("backstopSettings.markWelcomed"); } catch (Exception) { }
        Nav.NavigateTo(to);
    }
}
