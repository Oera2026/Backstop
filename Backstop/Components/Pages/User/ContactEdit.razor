@page "/contacts/{Id}"
@inherits LiveComponentBase

@{ var c = Mail.GetContact(Id); }

<BackLink Href="contacts" Text="My contacts" />

@if (c is null)
{
    <PageTitle>Not found – Backstop</PageTitle>
    <h1>We cannot find that person</h1>
}
else
{
    <PageTitle>@c.Name – Backstop</PageTitle>
    <h1>@c.Name</h1>

    <div class="photo-edit">
        <Avatar Contact="c" Large="true" />
        <div class="photo-edit__who">
            <strong>@c.Name</strong>
            <span>@c.Relationship</span>
            <span class="row__preview">@c.Address</span>
        </div>
    </div>

    <div class="actions">
        <InputFile id="photo" class="filepick" OnChange="Picked" accept="image/png,image/jpeg,image/webp,image/gif" />
        <label for="photo" class="btn btn-primary"><Icon Name="plus" /> @(c.PhotoUrl is null ? "Choose a photo" : "Choose a different photo")</label>
        @if (c.PhotoUrl is not null)
        {
            <button type="button" class="btn btn-quiet" @onclick="Remove"><Icon Name="cross" /> Take the photo away</button>
        }
    </div>
    <p class="form-error" role="alert">@_error</p>
    <p class="reply-status" role="status">@_done</p>
}

@code {
    private const long MaxBytes = 3 * 1024 * 1024;

    [Parameter] public string Id { get; set; } = "";

    private string _error = "", _done = "";

    private async Task Picked(InputFileChangeEventArgs e)
    {
        _error = _done = "";
        try
        {
            await using var stream = e.File.OpenReadStream(MaxBytes);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);

            if (Mail.SetContactPhoto(Id, memory.ToArray()))
                _done = "Done. The photo is saved.";
            else
                _error = "That file is not a picture we can use. Please choose a photo (PNG, JPEG, WebP or GIF).";
        }
        catch (IOException)
        {
            _error = "That picture is too big. Please choose a smaller one.";
        }
        catch (Exception)
        {
            _error = "We could not read that file. Please try again.";
        }
    }

    private void Remove()
    {
        Mail.RemoveContactPhoto(Id);
        _error = "";
        _done = "Done. The photo has been taken away.";
    }
}
