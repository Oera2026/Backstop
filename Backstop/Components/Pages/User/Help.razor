@page "/help"

<PageTitle>Help – Backstop</PageTitle>

<BackLink />
<h1>Help</h1>
<p class="lead">Here is how to do the main things.</p>
<ReadAloudButton Text="@Speech" />

<section aria-labelledby="h-read">
    <h2 id="h-read">How do I read a message?</h2>
    <p>Go to Inbox. Tap the message you want. Tap Read this to me if you want to hear it.</p>
</section>

<section aria-labelledby="h-write">
    <h2 id="h-write">How do I write a message?</h2>
    <p>Tap Write a message. Fill in who it is for and what you want to say. Then tap Send.</p>
</section>

<section aria-labelledby="h-big">
    <h2 id="h-big">How do I make the words bigger?</h2>
    <p>Open Settings at the top of the page. You can change the size of the words, the colours and more.</p>
    <p class="actions"><a class="btn btn-primary" href="/settings"><Icon Name="arrow-right" /> Open Settings</a></p>
</section>

<section aria-labelledby="h-stuck">
    <h2 id="h-stuck">What if I am stuck?</h2>
    <p>Ask your helper. They are the person you chose to look after your email.</p>
</section>

@code {
    private const string Speech =
        "Here is how to do the main things. To read a message, go to Inbox and tap the message you want. " +
        "To write a message, tap Write a message, fill it in, then tap Send. " +
        "To make the words bigger, open Settings at the top of the page. " +
        "If you are stuck, ask your helper.";
}
