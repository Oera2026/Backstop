@page "/home"
@inherits ModeComponentBase

<PageTitle>Home – Backstop</PageTitle>

<h1>Hello, @UserName</h1>
<p class="lead">What would you like to do?</p>

<nav aria-label="What you can do">
    <ul class="modecards">
        <li>
            <a class="modecard" href="/">
                <span class="pic pic--blue" aria-hidden="true"><Icon Name="mail" /></span>
                <span class="modecard__words">
                    <span class="modecard__title">Inbox</span>
                    <span class="modecard__hint">@InboxHint</span>
                </span>
                <Icon Name="arrow-right" />
            </a>
        </li>
        <li>
            <a class="modecard" href="stories">
                <span class="pic" aria-hidden="true"><Icon Name="story" /></span>
                <span class="modecard__words">
                    <span class="modecard__title">Stories</span>
                    <span class="modecard__hint">Get ready for what is coming up</span>
                </span>
                <Icon Name="arrow-right" />
            </a>
        </li>
        <li>
            <a class="modecard" href="make-sense">
                <span class="pic" aria-hidden="true"><Icon Name="chat" /></span>
                <span class="modecard__words">
                    <span class="modecard__title">Make sense of it</span>
                    <span class="modecard__hint">Something happened and I am not sure why</span>
                </span>
                <Icon Name="arrow-right" />
            </a>
        </li>
        <li>
            <a class="modecard" href="check">
                <span class="pic" aria-hidden="true"><Icon Name="inspect" /></span>
                <span class="modecard__words">
                    <span class="modecard__title">Check</span>
                    <span class="modecard__hint">Is a message or letter safe?</span>
                </span>
                <Icon Name="arrow-right" />
            </a>
        </li>
        <li>
            <a class="modecard" href="show-me">
                <span class="pic" aria-hidden="true"><Icon Name="camera" /></span>
                <span class="modecard__words">
                    <span class="modecard__title">Show me</span>
                    <span class="modecard__hint">Take a picture and see how to do it</span>
                </span>
                <Icon Name="arrow-right" />
            </a>
        </li>
        <li>
            <a class="modecard" href="explain">
                <span class="pic" aria-hidden="true"><Icon Name="book" /></span>
                <span class="modecard__words">
                    <span class="modecard__title">Explain</span>
                    <span class="modecard__hint">Make a letter easy to read</span>
                </span>
                <Icon Name="arrow-right" />
            </a>
        </li>
        <li>
            <a class="modecard" href="remember">
                <span class="pic" aria-hidden="true"><Icon Name="bookmark" /></span>
                <span class="modecard__words">
                    <span class="modecard__title">Remember</span>
                    <span class="modecard__hint">How did I do that before?</span>
                </span>
                <Icon Name="arrow-right" />
            </a>
        </li>
    </ul>
</nav>

@code {
    private string InboxHint
    {
        get
        {
            var n = Mail.GetInbox().Count;
            return n switch { 0 => "No messages yet", 1 => "1 message", _ => $"{n} messages" };
        }
    }
}
