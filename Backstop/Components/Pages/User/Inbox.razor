@page "/inbox"
@page "/"
@inherits LiveComponentBase

<PageTitle>Inbox – Backstop</PageTitle>

<h1>Inbox</h1>

<div class="home">
    <div class="home__side">
        <p class="actions">
            <a class="btn btn-primary" href="compose"><Icon Name="pen" /> Write a message</a>
        </p>

        <nav class="tiles" aria-label="Go to">
            <a class="tile" href="contacts"><span class="pic" aria-hidden="true"><Icon Name="people" /></span><span>Contacts</span></a>
            <a class="tile" href="sent"><span class="pic" aria-hidden="true"><Icon Name="send" /></span><span>Sent</span></a>
            <a class="tile" href="calendar"><span class="pic" aria-hidden="true"><Icon Name="calendar" /></span><span>Calendar</span></a>
            <a class="tile" href="search"><span class="pic" aria-hidden="true"><Icon Name="search" /></span><span>Search</span></a>
        </nav>
    </div>

    <div class="home__list">
        @if (Mail.HeldCount is var held and > 0)
        {
            <div class="banner banner--check" role="status">
                <Icon Name="hourglass" />
                <p>@(held == 1 ? "1 message is" : $"{held} messages are") being checked by your helper.</p>
            </div>
        }
        @if (Mail.RecentHelperBlocks is var blocked and > 0)
        {
            <p class="note" role="status"><Icon Name="cross" /> <span>@(blocked == 1 ? "Your helper blocked a message today." : $"Your helper blocked {blocked} messages today.")</span></p>
        }
        @* Privacy rule still holds: the user only ever sees Cleared mail (GetInbox). Held mail is simply not listed. *@
        @{ var inbox = Mail.GetInbox(); }
        @if (inbox.Count == 0)
        {
            <div class="emptystate">
                <span class="pic pic--blue" aria-hidden="true"><Icon Name="mail" /></span>
                <div>
                    <p class="emptystate__title">No messages yet</p>
                    <p>New messages will show here.</p>
                </div>
            </div>
        }
        else
        {
            var shown = _all ? inbox : inbox.Take(FirstPage).ToList();
            @foreach (var group in shown.GroupBy(m => DayName(m.ReceivedAt)))
            {
                <h2>@group.Key</h2>
                <ul class="rows" aria-label="@group.Key">
                    @foreach (var m in group)
                    {
                        <li>
                            <a class="row" href="message/@m.Id">
                                <span class="pic pic--blue" aria-hidden="true"><Icon Name="mail" /></span>
                                <span class="row__main">
                                    <span class="row__from">@m.FromName</span>
                                    <span class="row__subject">@m.Subject</span>
                                    <span class="row__time">@Clock.When(m.ReceivedAt)</span>
                                    <span class="row__preview">@Defang.ForUser(m.Preview)</span>
                                </span>
                            </a>
                        </li>
                    }
                </ul>
            }
            @if (!_all && inbox.Count > FirstPage)
            {
                <p class="actions"><button type="button" class="btn btn-quiet" @onclick="() => _all = true">Show older messages (@(inbox.Count - FirstPage))</button></p>
            }
        }
    </div>
</div>

@code {
    // The newest messages first; the rest wait behind one button, so the page stays short.
    private const int FirstPage = 15;
    private bool _all;

    private string DayName(DateTimeOffset at)
    {
        var day = DateOnly.FromDateTime(Clock.Local(at).DateTime);
        return day >= Clock.Today ? "Today" : day == Clock.Today.AddDays(-1) ? "Yesterday" : "Earlier";
    }
}
