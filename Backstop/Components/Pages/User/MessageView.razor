@page "/message/{Id}"
@inherits LiveComponentBase
@inject AskSession AskSession

@* Fail closed: GetClearedMessage returns null for anything that is not Cleared. *@
@{ var m = Mail.GetClearedMessage(Id); }

@if (m is null)
{
    <PageTitle>Message not ready – Backstop</PageTitle>
    <h1>We cannot find that message</h1>
    <p>It is not available.</p>
    <p class="actions">
        <a class="btn btn-primary" href="/"><Icon Name="arrow-left" /> Back to my messages</a>
    </p>
}
else
{
    var noReply = NoReply.IsNoReply(m.FromAddress);
    <PageTitle>@m.Subject – Backstop</PageTitle>
    <BackLink />
    <article class="reading" aria-labelledby="subject">
        <h1 id="subject">@m.Subject</h1>
        <p class="reading__from">From <strong>@m.FromName</strong> (@m.FromAddress)<br />@Clock.Long(m.ReceivedAt)</p>
        <div class="reading__body">
            @foreach (var line in Defang.ForUser(m.Body).Split('\n'))
            {
                @if (line.Length == 0) { continue; }
                <p>@line</p>
            }
        </div>
    </article>
    @if (noReply)
    {
        <p class="note"><Icon Name="cross" /> <span>You cannot reply to this message.</span></p>
    }
    <div class="actions">
        <ReadAloudButton Primary="true" Text="@($"Message from {m.FromName}. {m.Subject}. {Defang.ForUser(m.Body)}")" />
        @if (!noReply)
        {
            <a class="btn btn-quiet" href="compose?reply=@m.Id"><Icon Name="pen" /> Reply</a>
        }
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = "";

    // Ask Me can answer about the email that is open. It only ever gets a Cleared one.
    protected override void OnParametersSet() => AskSession.SetPage(this, () => new AskSession.PageContext(Id));

    public override void Dispose()
    {
        AskSession.ClearPage(this);
        base.Dispose();
    }
}
