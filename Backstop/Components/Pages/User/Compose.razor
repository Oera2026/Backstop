@page "/compose"
@inherits LiveComponentBase
@inject AskSession AskSession

@switch (_stage)
{
    case Stage.Pause:
        <PageTitle>Please wait – Backstop</PageTitle>
        <BackLink OnClick="GoBack" Text="Change my message" />
        <section class="pause" aria-labelledby="pause-title">
            <span class="pause__icon" aria-hidden="true"><Icon Name="hand" /></span>
            <h1 id="pause-title">You are about to send something private.</h1>
            <p class="lead">Your helper will check first.</p>
            @if (_reasons.Count > 0)
            {
                <ul class="plain-list">
                    @foreach (var r in _reasons)
                    {
                        <li>@r</li>
                    }
                </ul>
            }
            <div class="actions">
                <button type="button" class="btn btn-primary" @onclick="AskHelper"><Icon Name="user" /> Ask my helper</button>
                <ReadAloudButton Text="@PauseSpeech" />
            </div>
        </section>
        break;

    case Stage.Asked:
        <PageTitle>Your helper will check – Backstop</PageTitle>
        <section aria-labelledby="asked-title">
            <p><StatusBadge State="MessageState.Held" /></p>
            <h1 id="asked-title">We have not sent your message.</h1>
            <p class="lead">Your helper will look at it first.</p>
            <p class="actions"><a class="btn btn-primary" href="/inbox">Back to inbox</a></p>
        </section>
        break;

    case Stage.Sending:
        <PageTitle>Sending – Backstop</PageTitle>
        <section aria-labelledby="sending-title">
            <NavigationLock OnBeforeInternalNavigation="CancelSending" />
            <h1 id="sending-title">Sending your message</h1>
            <p class="lead" role="status">Sending in @_secs seconds.</p>
            <span class="countdown" style="--secs:@(UndoSeconds)s" aria-hidden="true"></span>
            <div class="actions">
                <button type="button" class="btn btn-primary" @onclick="Undo"><Icon Name="arrow-left" /> Undo</button>
            </div>
        </section>
        break;

    case Stage.Sent:
        <PageTitle>Message sent – Backstop</PageTitle>
        <section aria-labelledby="sent-title">
            <p><span class="badge badge--safe"><Icon Name="check" /><span>Sent</span></span></p>
            <h1 id="sent-title">Your message has been sent.</h1>
            <p class="actions"><a class="btn btn-primary" href="/inbox">Back to inbox</a></p>
        </section>
        break;

    default:
        <PageTitle>@(_reply is null ? "Write a message" : "Reply") – Backstop</PageTitle>
        <BackLink Href="@(_reply is null ? "/inbox" : $"message/{_reply.Id}")" Text="@(_reply is null ? "Inbox" : "The message")" />
        <h1>@(_reply is null ? "Write a message" : $"Reply to {_reply.FromName}")</h1>
        <form class="form" @onsubmit="Send" novalidate>
            <div class="field">
                <label for="to">To</label>
                @if (_locked)
                {
                    @* On a reply the heading already names the person. *@
                    @if (_reply is null)
                    {
                        var person = Mail.FindContact(_to);
                        <div class="recipient">
                            <Avatar Contact="person" />
                            <span class="recipient__who">
                                <strong>@(person?.Name ?? _to)</strong>
                                @if (person is not null) { <span>@person.Relationship</span> }
                            </span>
                        </div>
                    }
                    @* Read-only, so the address cannot be changed or spoiled by mistake. *@
                    <input id="to" type="email" value="@_to" readonly class="is-locked" />
                    @if (_reply is null)
                    {
                        <p class="hint"><a href="contacts">Choose someone else</a></p>
                    }
                }
                else
                {
                    <input id="to" type="email" inputmode="email" @bind="_to" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" enterkeyhint="next" data-enter-next placeholder="name@example.com" />
                }
            </div>
            @if (_reply is null)
            {
                <div class="field">
                    <label for="subject">Subject</label>
                    <input id="subject" type="text" @bind="_subject" autocomplete="off" enterkeyhint="next" data-enter-next />
                </div>
            }
            else
            {
                @* Picking an answer only fills in the message. Nothing is sent until Send. *@
                <ChoiceGroup Legend="Quick answer" Name="quick" Value="@_quick" OnPick="PickQuick" Options="@QuickOptions" />
            }
            <div class="field">
                <label for="body">Message</label>
                <textarea id="body" rows="7" @bind="_body" @bind:after="BodyEdited"></textarea>
            </div>
            <p class="form-error" role="alert">@_error</p>
            <div class="actions actions--stick">
                <button type="submit" class="btn btn-primary"><Icon Name="arrow-right" /> Send</button>
            </div>
        </form>
        break;
}

@code {
    private enum Stage { Form, Pause, Asked, Sending, Sent }

    private const int UndoSeconds = 5;

    private static readonly (string Value, string Label)[] QuickOptions =
        [("yes", "Yes"), ("no", "No"), ("thanks", "Thank you"), ("call", "Call me")];

    private static readonly Dictionary<string, string> QuickText = new()
    {
        ["yes"] = "Yes.", ["no"] = "No.", ["thanks"] = "Thank you.", ["call"] = "Please call me.",
    };

    private Stage _stage = Stage.Form;
    private string _to = "", _subject = "", _body = "", _error = "", _quick = "";
    private bool _locked;
    private IReadOnlyList<string> _reasons = [];
    private MailMessage? _reply;
    private int _secs;
    private CancellationTokenSource? _cts;

    [SupplyParameterFromQuery(Name = "to")] public string? ToAddress { get; set; }
    [SupplyParameterFromQuery(Name = "subject")] public string? SubjectText { get; set; }
    [SupplyParameterFromQuery(Name = "reply")] public string? ReplyId { get; set; }
    [SupplyParameterFromQuery(Name = "body")] public string? BodyText { get; set; }

    private string? _appliedQuery;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        // Ask Me can see the message being written, and the one being answered.
        AskSession.SetPage(this, () => new AskSession.PageContext(_reply?.Id, _to, _subject, _body));
    }

    // Contacts open this page with the person filled in. A reply takes the person and subject
    // from the message itself, and only from a Cleared one. Ask Me can open this page again with a
    // draft, so the link is read whenever it changes, not only the first time. A draft is only text
    // in the box: nothing is sent until the person presses Send.
    protected override void OnParametersSet()
    {
        var query = $"{ReplyId}|{ToAddress}|{SubjectText}|{BodyText}";
        if (query == _appliedQuery) return;
        var first = _appliedQuery is null;
        _appliedQuery = query;
        if (!first && _stage != Stage.Form) return;
        ApplyQuery();
    }

    private void ApplyQuery()
    {
        _reply = string.IsNullOrWhiteSpace(ReplyId) ? null : Mail.GetClearedMessage(ReplyId);
        // A link that carries only a draft (Ask Me) keeps the person and subject already typed.
        // Any other link starts clean, so nothing from an earlier reply carries over.
        var draftOnly = _reply is null && ReplyId is null && string.IsNullOrWhiteSpace(ToAddress)
            && string.IsNullOrWhiteSpace(SubjectText) && !string.IsNullOrWhiteSpace(BodyText);
        if (!draftOnly)
        {
            _to = ""; _subject = ""; _body = ""; _quick = ""; _locked = false;
        }
        _error = "";
        if (_reply is not null && !NoReply.IsNoReply(_reply.FromAddress))
        {
            _to = _reply.FromAddress;
            _subject = _reply.Subject.StartsWith("Re:", StringComparison.OrdinalIgnoreCase) ? _reply.Subject : "Re: " + _reply.Subject;
            _locked = true;
        }
        else
        {
            _reply = null;
            if (!string.IsNullOrWhiteSpace(ToAddress))
            {
                _to = ToAddress.Trim();
                _locked = true;
            }
            if (!string.IsNullOrWhiteSpace(SubjectText)) _subject = SubjectText;
        }
        if (!string.IsNullOrWhiteSpace(BodyText))
        {
            _body = BodyText.Length > 2000 ? BodyText[..2000] : BodyText;
            _quick = "";
        }
    }

    private string PauseSpeech =>
        "You are about to send something private. Your helper will check first. " + string.Join(' ', _reasons);

    private void PickQuick(string value)
    {
        // Only an empty box, or one still holding an earlier quick answer, is replaced. Typed words stay.
        var untouched = string.IsNullOrWhiteSpace(_body) || (_quick.Length > 0 && _body == QuickText[_quick]);
        _body = untouched ? QuickText[value] : _body.TrimEnd() + "\n" + QuickText[value];
        _quick = value;
    }

    // Typing over a quick answer un-picks it, so the choice never shows something the message no longer says.
    private void BodyEdited()
    {
        if (_quick.Length > 0 && _body != QuickText[_quick]) _quick = "";
    }

    private async Task Send()
    {
        _error = "";
        // A locked address always comes from the message or the link, never from anything typed on the page.
        if (_reply is not null) _to = _reply.FromAddress;
        else if (_locked && !string.IsNullOrWhiteSpace(ToAddress)) _to = ToAddress.Trim();
        if (string.IsNullOrWhiteSpace(_to) || !_to.Contains('@'))
        {
            _error = "Please type who this is for, like name@example.com.";
            return;
        }
        if (NoReply.IsNoReply(_to))
        {
            _error = "That is a no-reply address. Nobody reads messages sent to it, so we cannot send this.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_body))
        {
            _error = "Please write your message first.";
            return;
        }

        // MOCK outgoing check. A real service would scan the message and decide.
        var check = Mail.CheckOutgoing(_to, _subject, _body);
        if (check.NeedsPause)
        {
            _reasons = check.Reasons;
            _stage = Stage.Pause;
            return;
        }

        await StartSending();
    }

    // The message waits a few seconds so a wrong tap can be undone. Moving to another page in the app,
    // including the browser Back button, stops it. Closing the tab sends it, as the user asked.
    private async Task StartSending()
    {
        _stage = Stage.Sending;
        _secs = UndoSeconds;
        _cts = new CancellationTokenSource();
        var token = _cts.Token;
        try
        {
            while (_secs > 0)
            {
                await Task.Delay(1000, token);
                _secs--;
                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
            return;
        }
        Commit();
    }

    private void Commit()
    {
        _cts = null;
        var result = Mail.Send(_to, _subject, _body);
        if (result.Refused is not null)
        {
            _error = result.Refused;
            _stage = Stage.Form;
            return;
        }
        _stage = Stage.Sent;
    }

    private void CancelSending(LocationChangingContext context)
    {
        context.PreventNavigation();
        Undo();
        _error = "Not sent.";
    }

    private void Undo()
    {
        _cts?.Cancel();
        _cts = null;
        _stage = Stage.Form;
    }

    // The message is kept for the helper. Nothing is sent until they approve it.
    private void AskHelper()
    {
        if (!Mail.HoldOutgoing(_to, _subject, _body, _reasons))
        {
            _error = "That is a no-reply address. Nobody reads messages sent to it, so we cannot send this.";
            _stage = Stage.Form;
            return;
        }
        _stage = Stage.Asked;
    }

    private void GoBack() => _stage = Stage.Form;

    public override void Dispose()
    {
        AskSession.ClearPage(this);
        if (_stage == Stage.Sending)
        {
            _cts?.Cancel();
            Commit();
        }
        base.Dispose();
    }
}
