<CascadingValue Value="_clock" IsFixed="true">
    <Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.NotFound)">
        <Found Context="routeData">
            <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.UserLayout)" />
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
    </Router>
</CascadingValue>

@code {
    /// <summary>The browser's time zone, read from its cookie by App.razor.</summary>
    [Parameter] public string? TimeZone { get; set; }

    private UserClock _clock = UserClock.Server;

    protected override void OnInitialized() => _clock = UserClock.For(TimeZone);
}
