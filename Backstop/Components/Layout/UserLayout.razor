@inherits LayoutComponentBase

<a class="skip-link" href="#main">Skip to the message</a>
<header class="site-header" role="banner">
    <a class="brand" href="home" aria-label="Backstop, go to the home screen">
        <Logo /> <span class="brand__word">Backstop</span><span class="brand__home">Home</span>
    </a>
    <nav aria-label="Help and settings" class="site-nav">
        <GuideToggle />
        <a href="/help">Help</a>
        <a href="/settings">Settings</a>
        <a class="nav-signout" href="/account/logout" data-enhance-nav="false" target="_self">Sign out</a>
    </nav>
</header>
<RoleGate Allow="@Roles.UserSide">
<DemoBar />
<div class="shell">
    <AppNav />
    <main id="main" class="page" tabindex="-1">
        <p class="demo-row"><DemoLabel /></p>
        @Body
    </main>
    <AskDock />
    <ProfileMenu Role="ProfileRole.User" />
</div>
</RoleGate>

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong.
    <a href="." class="reload">Reload</a>
    <button type="button" class="dismiss" aria-label="Dismiss"><Icon Name="cross" /></button>
</div>
