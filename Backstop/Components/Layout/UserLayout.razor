@inherits LayoutComponentBase

<a class="skip-link" href="#main">Skip to the message</a>
<header class="site-header" role="banner">
    <a class="brand" href="/" aria-label="Backstop, go to my messages">
        <Icon Name="shield" /> <span>Backstop</span>
    </a>
</header>
<main id="main" class="page" tabindex="-1">
    @Body
</main>
<footer class="site-footer">
    <p>Backstop checks your mail before you see it.</p>
    <p><a href="/help">Need help? What does Safe mean?</a></p>
</footer>

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong.
    <a href="." class="reload">Reload</a>
    <button type="button" class="dismiss" aria-label="Dismiss"><Icon Name="cross" /></button>
</div>
