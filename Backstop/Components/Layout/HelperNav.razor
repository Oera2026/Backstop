@inherits LiveComponentBase
@implements IAsyncDisposable
@inject IJSRuntime Js

@* Same frame as the user's: a tab bar on phones, a side bar on wide screens (see modes.css .appnav). *@
@{
    var waiting = Waiting();
    var place = Place();
}
<nav class="appnav" aria-label="Helper">
    <ul class="appnav__list">
        <li>
            <a class="appnav__item @(place == "waiting" ? "appnav__item--on" : "")" href="/helper" aria-current="@(place == "waiting" ? "page" : null)">
                <Icon Name="hourglass" />
                <span>Waiting</span>
                @if (waiting > 0)
                {
                    <span class="nav-count" aria-label="@waiting waiting">@waiting</span>
                }
            </a>
        </li>
        <li>
            <a class="appnav__item @(place == "messages" ? "appnav__item--on" : "")" href="/helper/messages" aria-current="@(place == "messages" ? "page" : null)">
                <Icon Name="people" />
                <span>Messages</span>
            </a>
        </li>
        <li>
            <a class="appnav__item @(place == "settings" ? "appnav__item--on" : "")" href="/helper/settings" aria-current="@(place == "settings" ? "page" : null)">
                <Icon Name="lines" />
                <span>Settings</span>
            </a>
        </li>
    </ul>
</nav>

@code {
    private int _shown = -1;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Nav.LocationChanged += OnMoved;
    }

    private void OnMoved(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => _ = InvokeAsync(StateHasChanged);

    // Everything the helper has to look at or decide that lives in the mail store.
    private int Waiting() => Guardian.GetQueue().Count + Guardian.GetHeldOutgoing().Count + Guardian.GetNotices().Count;

    // Every helper page that is not Messages or Settings (a message, a check, a story) belongs to Waiting.
    private string Place()
    {
        var parts = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Split('/');
        var second = parts.Length > 1 ? parts[1] : "";
        return second switch { "messages" => "messages", "settings" => "settings", _ => "waiting" };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var n = Waiting();
        if (n == _shown) return;
        _shown = n;
        try { await Js.InvokeVoidAsync("backstop.setTitleCount", n); }
        catch (Exception ex) when (ex is JSDisconnectedException or InvalidOperationException or TaskCanceledException) { /* circuit closed or still prerendering */ }
    }

    public async ValueTask DisposeAsync()
    {
        Nav.LocationChanged -= OnMoved;
        base.Dispose();
        try { await Js.InvokeVoidAsync("backstop.setTitleCount", 0); }
        catch (Exception ex) when (ex is JSDisconnectedException or InvalidOperationException or TaskCanceledException) { }
    }
}
