@inherits ModeComponentBase
@implements IAsyncDisposable
@inject IJSRuntime Js

@* Same frame as the user's: a tab bar on phones, a side bar on wide screens (see modes.css .appnav). *@
@{
    var waiting = Api.GetHelperDigest().WaitingCount;
    var place = Place();
}
<nav class="appnav" aria-label="Helper">
    <ul class="appnav__list">
        @Item("/helper", "waiting", "hourglass", "Waiting", place, waiting)
        @Item("/helper/messages", "messages", "people", "Messages", place, 0)
        @Item("/helper/history", "history", "clock", "History", place, 0)
        @if (Guardian.Allows(HelperCapability.SendAsUser))
        {
            @Item("/helper/write", "write", "pen", "Write", place, 0)
        }
        @Item("/helper/settings", "settings", "lines", "Settings", place, 0)
    </ul>
</nav>

@code {
    private int _shown = -1;

    private RenderFragment Item(string href, string key, string icon, string label, string place, int count) =>
    @<li>
        <a class="appnav__item @(place == key ? "appnav__item--on" : "")" href="@href" aria-current="@(place == key ? "page" : null)">
            <Icon Name="@icon" />
            <span>@label</span>
            @if (count > 0)
            {
                <span class="nav-count" aria-label="@count waiting">@count</span>
            }
        </a>
    </li>;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Nav.LocationChanged += OnMoved;
    }

    private void OnMoved(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => _ = InvokeAsync(StateHasChanged);

    // Every helper page that is not one of the others (a message, a check, a story) belongs to Waiting.
    private string Place()
    {
        var parts = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Split('/');
        var second = parts.Length > 1 ? parts[1] : "";
        return second switch { "messages" => "messages", "history" => "history", "write" => "write", "settings" => "settings", _ => "waiting" };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var n = Api.GetHelperDigest().WaitingCount;
        if (n == _shown) return;
        _shown = n;
        try { await Js.InvokeVoidAsync("backstop.setTitleCount", n); }
        catch (Exception ex) when (ex is JSDisconnectedException or InvalidOperationException or TaskCanceledException) { /* circuit closed or still prerendering */ }
    }

    public async ValueTask DisposeAsync()
    {
        Nav.LocationChanged -= OnMoved;
        base.Dispose();
        try { await Js.InvokeVoidAsync("backstop.setTitleCount", 0); }
        catch (Exception ex) when (ex is JSDisconnectedException or InvalidOperationException or TaskCanceledException) { }
    }
}
