@inherits LayoutComponentBase
@inject IBackstopApi Api

<a class="skip-link" href="#main">Skip to the content</a>
<header class="site-header site-header--helper" role="banner">
    <a class="brand" href="/helper" aria-label="Backstop helper, go to the queue">
        <Logo /> <span class="brand__word">Backstop</span> <span class="role-tag">Helper</span>
    </a>
    <p class="header-for"><Icon Name="eye" /> <span>For @Api.Household.UserName</span></p>
    <nav aria-label="Account" class="site-nav">
        <GuideToggle />
        <a class="nav-signout" href="/account/logout" data-enhance-nav="false" target="_self">Sign out</a>
    </nav>
</header>
<RoleGate Allow="@Roles.HelperSide">
<DemoBar />
<div class="shell">
    <HelperNav />
    <main id="main" class="page page--wide" tabindex="-1">
        @Body
    </main>
    <ProfileMenu Role="ProfileRole.Helper" />
</div>
</RoleGate>

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong.
    <a href="." class="reload">Reload</a>
    <button type="button" class="dismiss" aria-label="Dismiss"><Icon Name="cross" /></button>
</div>
