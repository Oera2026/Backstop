@inherits LayoutComponentBase
@inject IBackstopApi Api

<a class="skip-link" href="#main">Skip to the content</a>
<header class="site-header site-header--helper" role="banner">
    <a class="brand" href="/helper" aria-label="Backstop helper, go to the queue">
        <Logo /> <span class="brand__word">Backstop</span> <span class="role-tag">Helper<span class="role-tag__who"> for @Api.Household.UserName</span></span>
    </a>
    <nav aria-label="Account" class="site-nav">
        <a class="welcome-link" href="/demo-start" data-enhance-nav="false" aria-label="Back to the welcome screen"><Icon Name="arrow-left" /><span>Welcome</span></a>
        <GuideToggle />
    </nav>
</header>
<DemoBar />
<div class="shell">
    <HelperNav />
    <main id="main" class="page page--wide" tabindex="-1">
        <p class="demo-row"><DemoLabel /></p>
        @Body
    </main>
    <ProfileMenu Role="ProfileRole.Helper" />
</div>

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong.
    <a href="." class="reload">Reload</a>
    <button type="button" class="dismiss" aria-label="Dismiss"><Icon Name="cross" /></button>
</div>
