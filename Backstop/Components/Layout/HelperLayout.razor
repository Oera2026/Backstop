@inherits LayoutComponentBase
@inject IBackstopApi Api

<a class="skip-link" href="#main">Skip to the content</a>
<header class="site-header site-header--helper" role="banner">
    <a class="brand" href="/helper" aria-label="Backstop helper, go to the queue">
        <Logo /> <span>Backstop</span> <span class="role-tag">Helper</span>
    </a>
</header>
@* Says whose account this is on every helper page, so the two roles are never mixed up. *@
<p class="review-banner"><Icon Name="eye" /> Reviewing for @Api.Household.UserName</p>
<div class="shell">
    <HelperNav />
    <main id="main" class="page page--wide" tabindex="-1">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong.
    <a href="." class="reload">Reload</a>
    <button type="button" class="dismiss" aria-label="Dismiss"><Icon Name="cross" /></button>
</div>
