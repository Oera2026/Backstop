@inherits LayoutComponentBase

<a class="skip-link" href="#main">Skip to the page</a>
<header class="site-header" role="banner">
    <a class="brand" href="/demo-start" aria-label="Backstop, go to the start page">
        <Logo /> <span class="brand__word">Backstop</span>
    </a>
</header>
<main id="main" class="page page--try" tabindex="-1">
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong.
    <a href="." class="reload">Reload</a>
    <button type="button" class="dismiss" aria-label="Dismiss"><Icon Name="cross" /></button>
</div>
