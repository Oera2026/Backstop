@implements IDisposable
@inject NavigationManager Nav

@* One list of places. On phones it is a tab bar at the bottom; on wide screens a side bar (see modes.css). *@
<nav class="appnav" aria-label="Main">
    <ul class="appnav__list">
        @foreach (var item in Items)
        {
            var on = IsCurrent(item);
            <li class="@(item.PhoneToo ? "" : "appnav__wide-only")">
                <a class="appnav__item @(on ? "appnav__item--on" : "")" href="@item.Href" aria-current="@(on ? "page" : null)">
                    <Icon Name="@item.Icon" />
                    <span>@item.Label</span>
                </a>
            </li>
        }
    </ul>
</nav>

@code {
    private sealed record Item(string Href, string Icon, string Label, string[] Paths, bool PhoneToo);

    // Five places on the phone tab bar.
    private static readonly Item[] Items =
    [
        new("home", "home", "Home", ["home"], false),
        new("/", "mail", "Inbox", ["", "message", "compose", "sent", "contacts", "calendar", "search"], true),
        new("ask-me", "chat", "Ask Me", ["ask-me", "check", "stories", "make-sense", "show-me", "explain"], true),
        new("messages", "people", "Messages", ["messages"], true),
        new("remember", "bookmark", "Remember", ["remember"], true),
    ];

    protected override void OnInitialized() => Nav.LocationChanged += OnMoved;

    private void OnMoved(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    private bool IsCurrent(Item item)
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Split('/')[0];
        return item.Paths.Contains(path, StringComparer.OrdinalIgnoreCase);
    }

    public void Dispose() => Nav.LocationChanged -= OnMoved;
}
