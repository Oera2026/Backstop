@inherits LayoutComponentBase

<a class="skip-link" href="#main">Skip to the demo</a>
<header class="site-header site-header--demo" role="banner">
    <a class="brand" href="/demo" aria-label="Backstop demo panel">
        <Logo /> <span>Backstop</span> <span class="role-tag">Demo</span>
    </a>
    <nav aria-label="Views" class="site-nav">
        <a href="/">User</a>
        <a href="/helper">Helper</a>
        <a href="/demo">Demo</a>
    </nav>
</header>
<RoleGate Allow="@Roles.Demo" Guest="/account/demo?next=demo">
@* No guide bar here: the guide walks the user and helper pages, so on this page it could only send the visitor away from it. *@
<main id="main" class="page page--demo" tabindex="-1">
    @Body
</main>
</RoleGate>
<footer class="site-footer">
    <p>Demo only. All messages are made up. Nothing is sent anywhere.</p>
</footer>

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong.
    <a href="." class="reload">Reload</a>
    <button type="button" class="dismiss" aria-label="Dismiss"><Icon Name="cross" /></button>
</div>
