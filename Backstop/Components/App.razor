<!DOCTYPE html>
<html lang="en-GB">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#1E3A8A" />
    <meta name="description" content="Backstop is a simple, easy-to-read email app." />
    <base href="/" />
    <script src="@Assets["js/settings.js"]"></script>
    <link rel="manifest" href="manifest.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="icons/icon.svg" />
    <link rel="apple-touch-icon" href="icons/icon-192.png" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["css/theme.css"]" />
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <link rel="stylesheet" href="@Assets["css/modes.css"]" />
    <link rel="stylesheet" href="@Assets["css/motion.css"]" />
    <link rel="stylesheet" href="@Assets["Backstop.styles.css"]" />
    <title>Backstop</title>
    <link rel="preload" href="fonts/atkinson-next-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="fonts/atkinson-next-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="fonts/atkinson-next-800.woff2" as="font" type="font/woff2" crossorigin />
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveNoPrerender" />
</head>

<body>
    <div class="boot" aria-hidden="true">
        <span class="skel__bar skel__bar--title"></span>
        <div class="skel">
            @for (var i = 0; i < 3; i++)
            {
                <div class="skel__row"><span class="skel__pic"></span><span class="skel__lines"><span class="skel__bar skel__bar--short"></span><span class="skel__bar"></span></span></div>
            }
        </div>
    </div>
    <Routes @rendermode="PageRenderMode" TimeZone="@HttpContext?.Request.Cookies["backstop.tz"]" />
    <ReconnectModal />
    <script src="@Assets["js/backstop.js"]"></script>
    <script src="@Assets["js/tour.js"]"></script>
    <script src="@Assets["js/camera.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    // Pages are drawn once, when the live connection opens. Drawing them on the server first and then again
    // makes everything flash and jump; the start-up shapes above fill the gap instead.
    private static readonly IComponentRenderMode InteractiveNoPrerender = new InteractiveServerRenderMode(prerender: false);

    // The sign-in page is plain server-rendered HTML (its form posts to /account/login); everything else is interactive.
    private IComponentRenderMode? PageRenderMode =>
        HttpContext?.Request.Path.StartsWithSegments("/login") == true || HttpContext?.Request.Path.StartsWithSegments("/demo-start") == true ? null : InteractiveNoPrerender;
}
