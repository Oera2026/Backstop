<!DOCTYPE html>
<html lang="en-GB">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#1E3A8A" />
    <meta name="description" content="Backstop is a simple, easy-to-read email app." />
    <base href="/" />
    <script src="@Assets["js/settings.js"]"></script>
    <link rel="manifest" href="manifest.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="icons/icon.svg" />
    <link rel="apple-touch-icon" href="icons/icon-192.png" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["css/theme.css"]" />
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <link rel="stylesheet" href="@Assets["css/modes.css"]" />
    <link rel="stylesheet" href="@Assets["css/motion.css"]" />
    <link rel="stylesheet" href="@Assets["css/desktop.css"]" />
    <link rel="stylesheet" href="@Assets["Backstop.styles.css"]" />
    <title>Backstop</title>
    <link rel="preload" href="fonts/atkinson-next-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="fonts/atkinson-next-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="fonts/atkinson-next-800.woff2" as="font" type="font/woff2" crossorigin />
    <HeadOutlet @rendermode="InteractiveNoPrerender" />
</head>

<body>
    <div class="boot" aria-hidden="true">
        @* The same frame the real page gets (header, side bar or tab bar, page column), so nothing moves when the page arrives. *@
        <div class="site-header"><span class="brand"><Logo /> <span class="brand__word">Backstop</span></span></div>
        <div class="shell">
            @if (HasNav)
            {
                <div class="boot__nav">
                    @for (var i = 0; i < 5; i++) { <span class="skel__bar boot__navitem"></span> }
                </div>
            }
            <div class="page @(IsHelper ? "page--wide" : "") @(IsHome ? "boot__home" : "")">
                <span class="skel__bar skel__bar--title"></span>
                @* Each kind of page gets its own shape, so the first look matches the page that arrives. *@
                @if (IsHome)
                {
                    <div class="home">
                        <div class="home__side">
                            <span class="skel__bar boot__button"></span>
                            <div class="tiles">
                                @for (var i = 0; i < 4; i++) { <span class="skel__bar boot__tile"></span> }
                            </div>
                        </div>
                        <div class="home__list">
                            <ul class="rows">
                                @for (var i = 0; i < 3; i++)
                                {
                                    <li class="row"><span class="skel__pic"></span><span class="row__main skel__lines"><span class="skel__bar skel__bar--short"></span><span class="skel__bar"></span></span></li>
                                }
                            </ul>
                        </div>
                    </div>
                }
                else if (IsListPath)
                {
                    <ul class="rows">
                        @for (var i = 0; i < 3; i++)
                        {
                            <li class="row"><span class="skel__pic"></span><span class="row__main skel__lines"><span class="skel__bar skel__bar--short"></span><span class="skel__bar"></span></span></li>
                        }
                    </ul>
                }
                else
                {
                    <div class="skel__panel"><span class="skel__bar"></span><span class="skel__bar"></span><span class="skel__bar"></span><span class="skel__bar skel__bar--short"></span></div>
                }
            </div>
        </div>
        @if (HasNav)
        {
            <div class="boot__tabs"></div>
        }
    </div>
    <Routes @rendermode="PageRenderMode" TimeZone="@HttpContext?.Request.Cookies["backstop.tz"]" />
    <ReconnectModal />
    <script src="@Assets["js/backstop.js"]"></script>
    <script src="@Assets["js/tour.js"]"></script>
    <script src="@Assets["js/camera.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    // Pages are drawn once, when the live connection opens. Drawing them on the server first and then again
    // makes everything flash and jump; the start-up shapes above fill the gap instead.
    private static readonly IComponentRenderMode InteractiveNoPrerender = new InteractiveServerRenderMode(prerender: false);

    private static readonly string[] ListPaths = ["", "messages", "stories", "remember", "contacts", "sent", "helper", "helper/messages", "helper/history"];
    // Pages with no side bar or tab bar: sign-in, the demo panel and the welcome walkthroughs.
    private static readonly string[] NoNavPaths = ["login", "demo-start", "demo", "welcome", "helper/welcome", "try"];
    private string Path => (HttpContext?.Request.Path.Value ?? "").Trim('/').ToLowerInvariant();
    private bool IsListPath => ListPaths.Contains(Path);
    private bool IsHome => Path == "home";
    private bool IsHelper => Path == "helper" || Path.StartsWith("helper/");
    private bool HasNav => !NoNavPaths.Contains(Path);

    // The sign-in page is plain server-rendered HTML (its form posts to /account/login); everything else is interactive.
    private IComponentRenderMode? PageRenderMode =>
        HttpContext?.Request.Path.StartsWithSegments("/login") == true || HttpContext?.Request.Path.StartsWithSegments("/demo-start") == true ? null : InteractiveNoPrerender;
}
