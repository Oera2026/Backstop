# Backstop environment placeholders.
# Leave them empty here and put real values only in your local .env (which is git-ignored).
# In production, set them in the host's environment variables.

# Meta Dev API (https://api.meta.ai/v1). Scam checks, Ask Me and safeguarding.
# Full URL of the chat endpoint, used exactly as written (no path is added). muse-spark-1.3 works; muse-spark-1.3-contributor gave 404.
META_AI_KEY=
META_AI_ENDPOINT_URL=https://api.meta.ai/v1/chat/completions
META_AI_MODEL=muse-spark-1.3
# Seconds to wait for Meta. Muse models take 10 to 30 seconds to answer, so values under 30 are raised to 30. 45 is recommended.
META_AI_TIMEOUT_SECONDS=45

# Limits on calls to Meta (this app's own caps; a restart resets the counts).
META_AI_MAX_CALLS_PER_DAY=
META_AI_MAX_CALLS_PER_IP_PER_MINUTE=

# Optional. Name of a header the host's proxy sets to the visitor's address (for example CF-Connecting-IP).
# Leave empty to use X-Forwarded-For. Only set it if the proxy overwrites that header on every request, or visitors can fake their address.
CLIENT_IP_HEADER=

# Needed to use "Reset demo" on /demo. With no value, reset is switched off.
DEMO_RESET_SECRET=

# Optional blocklist lookups for the Try it page only (Link check). Leave empty to skip them silently.
# Google Safe Browsing: safebrowsing.googleapis.com. URLhaus: urlhaus-api.abuse.ch. Only the link address is sent.
SAFE_BROWSING_API_KEY=
URLHAUS_AUTH_KEY=

# Set to true to show the "Test the connection" button (it prints settings and Meta's raw reply). Leave empty in production.
ENABLE_DIAGNOSTICS=
META_AI_MAX_CALLS_PER_IP_PER_DAY=
