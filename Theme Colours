:root {
  /* Surfaces */
  --bg: #FFFFFF;
  --surface: #F5F7FA;          /* cards, panels */
  --border: #E3E8EF;

  /* Text (all AA+ on white) */
  --text: #1D1D1F;
  --text-2: #4B5563;

  /* Brand */
  --accent: #0064E0;           /* 5.4:1 on white, so white button text passes AA */
  --accent-hover: #0050B8;
  --accent-soft: #E8F1FE;
  --focus: 3px solid #0064E0;  /* always-visible keyboard focus ring */

  /* Status: always paired with an icon AND a word, never colour alone */
  --safe: #1B7A4B;   --safe-soft: #E7F5EC;
  --check: #8A5A00;  --check-soft: #FFF4D6;   /* "Being checked": amber, not alarming */
  --block: #C0262D;  --block-soft: #FDECEC;

  /* Shape and type */
  --radius: 16px;  --radius-lg: 24px;
  --shadow: 0 2px 12px rgba(16, 24, 40, .06);
  --font: "Inter", system-ui, -apple-system, "Segoe UI Variable", sans-serif;
  --fs-base: 20px;  --lh: 1.6;
  --tap: 56px;                 /* minimum button height */
}
